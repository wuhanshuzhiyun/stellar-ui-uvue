<template>
	<scroll-view direction="vertical" class="page">
		<!-- 顶部标题介绍 -->
		<view class="header">
			<text class="title">MessageBox 弹框</text>
			<text class="desc">模拟系统的消息提示框而实现的一套模态对话框组件，用于消息提示、确认操作与提交输入内容。</text>
		</view>

		<!-- 演示用例 1：基础提示 -->
		<view class="section">
			<text class="section-title">1. 基础使用</text>
			<view class="demo-row">
				<view class="btn-wrap">
					<ste-button @click="onOpenBasic">基础提示弹窗</ste-button>
				</view>
			</view>
		</view>

		<!-- 演示用例 2：内置状态图标 -->
		<view class="section">
			<text class="section-title">2. 内置状态图标 (Info / Success / Error)</text>
			<view class="demo-row">
				<view class="btn-wrap">
					<ste-button @click="onOpenIcon('info')">信息提示</ste-button>
				</view>
				<view class="btn-wrap">
					<ste-button background="#00c250" @click="onOpenIcon('success')">成功提示</ste-button>
				</view>
				<view class="btn-wrap">
					<ste-button background="#fa5151" @click="onOpenIcon('error')">失败提示</ste-button>
				</view>
			</view>
		</view>

		<!-- 演示用例 3：自定义按钮与单按钮 -->
		<view class="section">
			<text class="section-title">3. 自定义操作按钮</text>
			<view class="demo-row">
				<view class="btn-wrap">
					<ste-button @click="onOpenCustomBtn">自定义文字与颜色</ste-button>
				</view>
				<view class="btn-wrap">
					<ste-button background="#ff9900" @click="onOpenSingleBtn">单确认按钮 (无取消)</ste-button>
				</view>
			</view>
		</view>

		<!-- 演示用例 4：可编辑输入框 (Prompt 模式) -->
		<view class="section">
			<text class="section-title">4. 输入框模式 (Prompt)</text>
			<view class="demo-row">
				<view class="btn-wrap">
					<ste-button @click="onOpenPrompt">弹出输入框</ste-button>
				</view>
			</view>
			<view class="result-box" v-if="promptResult != ''">
				<text class="result-text">已提交输入内容：{{ promptResult }}</text>
			</view>
		</view>

		<!-- 演示用例 5：自定义插槽内容 (Slot) -->
		<view class="section">
			<text class="section-title">5. 自定义插槽内容 (Slot)</text>
			<view class="demo-row">
				<view class="btn-wrap">
					<ste-button @click="onOpenSlot">自定义插槽扩展</ste-button>
				</view>
			</view>
		</view>

		<!-- 演示用例 6：回调函数与结果监听 (独立演示) -->
		<view class="section">
			<text class="section-title">6. 事件回调与监听</text>
			<view class="demo-row">
				<view class="btn-wrap">
					<ste-button @click="onTestCancelCallback">监听取消回调</ste-button>
				</view>
				<view class="btn-wrap">
					<ste-button background="#00c250" @click="onTestConfirmCallback">监听确认回调</ste-button>
				</view>
				<view class="btn-wrap">
					<ste-button background="#ff9900" @click="onTestCompleteCallback">监听完成回调</ste-button>
				</view>
			</view>
			<view class="result-box" v-if="lastActionText != ''">
				<text class="result-text">最新触发回调：{{ lastActionText }}</text>
			</view>
		</view>

		<!-- 全局默认实例 (供 useMessageBox() 组合式 API 调用) -->
		<ste-message-box />

		<!-- 专属插槽实例 -->
		<ste-message-box selector="customSlotBox">
			<view class="custom-slot-content">
				<text class="slot-desc">这是一个通过自定义 Slot 注入的富文本与徽标区域：</text>
				<view class="slot-badge">
					<text class="slot-badge-text">VIP 特权生效中 ⭐️</text>
				</view>
			</view>
		</ste-message-box>
	</scroll-view>
</template>

<script setup lang="uts">
	/**
	 * @file message-box.uvue
	 * @description MessageBox 模态弹框组件交互演示页面
	 */

	import { ref } from 'vue'
	import { useMessageBox } from '@/uni_modules/stellar-ui-uvue/components/ste-message-box/use-message-box.uts'
	import { MessageBoxOptions } from '@/uni_modules/stellar-ui-uvue/components/ste-message-box/constants.uts'

	defineOptions({ name: 'demo-message-box' })

	// 全局默认 MessageBox 组合式调用句柄 (无参调用)
	const msgBox = useMessageBox()
	// 专属插槽 MessageBox 组合式调用句柄 (传 selector 参数)
	const slotMsgBox = useMessageBox('customSlotBox')

	const promptResult = ref<string>('')
	const lastActionText = ref<string>('')

	/** 1. 基础提示弹窗 */
	function onOpenBasic() {
		msgBox.showMsgBox({
			title: '删除确认',
			content: '确定要删除这条收货地址记录吗？\n删除后不可恢复。',
			showCancel: true,
			confirm: (_val : string) => {
				uni.showToast({ title: '已确认删除', icon: 'success' })
			},
			cancel: (_val : string) => {
				uni.showToast({ title: '已取消操作', icon: 'none' })
			}
		} as MessageBoxOptions)
	}

	/** 2. 内置状态图标 */
	function onOpenIcon(type : string) {
		if (type == 'success') {
			msgBox.showMsgBox({
				title: '支付成功',
				icon: 'success',
				confirmText: '我知道了',
				showCancel: false,
			} as MessageBoxOptions)
		} else if (type == 'error') {
			msgBox.showMsgBox({
				title: '网络连接超时',
				icon: 'error',
				confirmText: '重试',
				showCancel: true,
			} as MessageBoxOptions)
		} else {
			msgBox.showMsgBox({
				title: '温馨提示',
				icon: 'info',
				confirmText: '确定',
				showCancel: true,
			} as MessageBoxOptions)
		}
	}

	/** 3. 自定义操作按钮 */
	function onOpenCustomBtn() {
		msgBox.showMsgBox({
			title: '重要操作',
			content: '检测到您的账号存在异常登录，是否立即前往安全中心修改密码？',
			cancelText: '稍后再说',
			cancelColor: '#8f959e',
			confirmText: '立即修改',
			confirmColor: '#fa5151',
			showCancel: true,
		} as MessageBoxOptions)
	}

	/** 单确认按钮 */
	function onOpenSingleBtn() {
		msgBox.showMsgBox({
			title: '系统维护通知',
			content: '服务器将于今晚 24:00 进行例行升级，预计耗时 2 小时。',
			confirmText: '收到',
			showCancel: false,
		} as MessageBoxOptions)
	}

	/** 4. 输入框模式 (Prompt) */
	function onOpenPrompt() {
		msgBox.showMsgBox({
			title: '重命名项目',
			editable: true,
			placeholderText: '请输入新的项目名称',
			showCancel: true,
			confirm: (val : string) => {
				promptResult.value = val != '' ? val : '（未输入内容）'
				uni.showToast({ title: '重命名成功: ' + val, icon: 'none' })
			}
		} as MessageBoxOptions)
	}

	/** 5. 自定义插槽内容 */
	function onOpenSlot() {
		slotMsgBox.showMsgBox({
			title: '特权说明',
			showCancel: false,
			confirmText: '了解详情',
		} as MessageBoxOptions)
	}

	/** 6.1 监听取消回调 */
	function onTestCancelCallback() {
		msgBox.showMsgBox({
			title: '取消回调演示',
			content: '点击【取消】按钮将触发 cancel 回调',
			showCancel: true,
			cancel: (_val : string) => {
				lastActionText.value = '已触发 cancel (取消) 回调'
				uni.showToast({ title: '已触发 cancel 取消回调', icon: 'none' })
			}
		} as MessageBoxOptions)
	}

	/** 6.2 监听确认回调 */
	function onTestConfirmCallback() {
		msgBox.showMsgBox({
			title: '确认回调演示',
			content: '点击【确认】按钮将触发 confirm 回调',
			showCancel: true,
			confirm: (_val : string) => {
				lastActionText.value = '已触发 confirm (确认) 回调'
				uni.showToast({ title: '已触发 confirm 确认回调', icon: 'success' })
			}
		} as MessageBoxOptions)
	}

	/** 6.3 监听完成回调 (无论点确认还是取消都会触发) */
	function onTestCompleteCallback() {
		msgBox.showMsgBox({
			title: '完成回调演示',
			content: '无论点击【确认】还是【取消】，关闭时都会触发 complete 回调',
			showCancel: true,
			complete: (_val : string) => {
				lastActionText.value = '已触发 complete (完成) 回调'
				uni.showToast({ title: '已触发 complete 完成回调', icon: 'none' })
			}
		} as MessageBoxOptions)
	}
</script>

<style>
	.page {
		padding: 24rpx;
		background-color: #f7f8fa;
		flex: 1;
	}

	.header {
		padding: 20rpx 8rpx 30rpx 8rpx;
	}

	.title {
		font-size: 38rpx;
		font-weight: bold;
		color: #1f2329;
	}

	.desc {
		font-size: 26rpx;
		color: #8f959e;
		margin-top: 12rpx;
		line-height: 38rpx;
	}

	.section {
		background-color: #ffffff;
		border-radius: 20rpx;
		margin-bottom: 24rpx;
		padding: 28rpx;
	}

	.section-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #1f2329;
		margin-bottom: 24rpx;
	}

	.demo-row {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
	}

	.btn-wrap {
		margin-right: 16rpx;
		margin-bottom: 16rpx;
	}

	.result-box {
		margin-top: 20rpx;
		padding: 16rpx 20rpx;
		background-color: #f0f7ff;
		border-radius: 12rpx;
	}

	.result-text {
		font-size: 26rpx;
		color: #0090ff;
		font-weight: 500;
	}

	.custom-slot-content {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 10rpx 0;
	}

	.slot-desc {
		font-size: 26rpx;
		color: #646a73;
		text-align: center;
		margin-bottom: 16rpx;
	}

	.slot-badge {
		padding: 8rpx 24rpx;
		background-color: #fff7e6;
		border-radius: 20rpx;
		border: 1rpx solid #ffd591;
	}

	.slot-badge-text {
		font-size: 24rpx;
		color: #d46b08;
		font-weight: bold;
	}
</style>
