		padding: 16rpx 0;
		display: flex;
		flex-direction: row;
		justify-content: center;
	}

	.mb-16 {
		margin-bottom: 16rpx;
	}

	.mb-24 {
		margin-bottom: 24rpx;
	}

	/* 自定义副标题插槽排版 */
	.custom-desc-row {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.custom-desc-text {
		font-size: 22rpx;
