	.badge-gold-text {
		font-size: 20rpx;
		color: #b45309;
		background-color: #fef3c7;
		padding: 2rpx 10rpx;
		border-radius: 6rpx;
	}

	/* 控制按钮栏 */
	.btn-group {
		margin-top: 16rpx;
		display: flex;
		flex-direction: row;
	}

	.btn-item {
		flex: 1;
	}

	.ctrl-btn-text {
		font-size: 28rpx;
		color: #ffffff;
	}
</style>
