		color: #999999;
		line-height: 34rpx;
		margin-bottom: 24rpx;
	}

	/* 单个组件嵌入底盒（灰色底衬托白色卡片） */
	.card-inner {
		background-color: #f2f3f5;
		border-radius: 16rpx;
		padding: 16rpx;
	}

	.mb-16 {
		margin-bottom: 16rpx;
	}

	.mb-24 {
		margin-bottom: 24rpx;
	}

	/* 自定义插槽样式 */
	.custom-badge-row {
		flex-direction: row;
		align-items: center;
	}

	.badge-tag {
		background-color: #0090ff;
		border-radius: 6rpx;
		padding: 2rpx 10rpx;
		margin-right: 12rpx;
	}

	.badge-tag-text {
		color: #ffffff;
		font-size: 20rpx;
		font-weight: 600;
	}

	.badge-score-text {
		color: #0090ff;
		font-size: 24rpx;
		font-weight: 500;
	}

	/* 控制按钮组 */
	.btn-group {
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
	}

	.btn-item {
		margin-right: 20rpx;
		margin-bottom: 12rpx;
	}

	/* 操作日志盒子 */
	.log-box {
		background-color: #f9f9f9;
		border-radius: 8rpx;
		padding: 20rpx;
		border-left-width: 6rpx;
		border-left-style: solid;
		border-left-color: #0090ff;
	}

	.log-text {
		font-size: 24rpx;
		color: #555555;
		line-height: 36rpx;
	}
