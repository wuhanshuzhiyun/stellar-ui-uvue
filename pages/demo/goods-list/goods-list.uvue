}

.card-desc {
	font-size: 22rpx;
	color: #8f959e;
	margin-top: 8rpx;
	margin-bottom: 20rpx;
	line-height: 32rpx;
}

.card-content {
	background-color: #fcfdfe;
	border-radius: 12rpx;
	border: 1rpx solid #edf0f5;
	overflow: hidden;
}

/* 标题右侧插槽按钮 */
.method-action-btn {
	display: flex;
