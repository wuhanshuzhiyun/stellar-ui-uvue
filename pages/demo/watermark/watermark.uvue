<template>
	<scroll-view direction="vertical" class="page">
		<!-- 全屏水印示例（根据开关状态动态控制是否展示） -->
		<ste-watermark
			v-if="showFullScreenWatermark"
			content="Stellar UI uvue"
			:fullPage="true"
		/>

		<!-- 顶部标题与功能描述 -->
		<view class="header">
			<text class="title">Watermark 水印</text>
			<text class="desc">在页面或指定容器区域平铺文字、多行文本或图片水印，原生防穿透设计保障底层操作无阻。</text>
		</view>

		<!-- 1. 全屏水印控制与点击穿透验证 -->
		<view class="section">
			<text class="section-title">1. 全屏水印与事件穿透验证</text>
			<view class="card">
				<text class="card-desc">全屏水印开启时将覆盖整个页面，但不会阻碍任何点击与交互。</text>
				<view class="action-row">
					<button
						class="btn primary-btn"
						@click="toggleFullScreenWatermark"
					>
						{{ showFullScreenWatermark ? '关闭全屏水印' : '开启全屏水印' }}
					</button>
					<button
						class="btn test-btn"
						@click="handleTestClick"
					>
						点击测试 (次数: {{ clickCount }})
					</button>
				</view>
			</view>
		</view>

		<!-- 2. 局部多行文本水印 -->
		<view class="section">
			<text class="section-title">2. 局部容器与多行文本水印</text>
			<view class="card demo-container">
				<!-- 宿主容器内部放置局部水印 -->
				<ste-watermark
					:fullPage="false"
					:content="['Stellar UI uvue', 'Confidential 绝密', '2025-09-04']"
					:width="150"
					:height="80"
				/>
				<!-- 容器卡片内容 -->
				<view class="demo-card-inner">
					<text class="inner-title">企业合同保密详情</text>
					<text class="inner-text">这是一段受局部水印保护的内容区域。只有该卡片容器内部会平铺多行水印，不会溢出到外部。</text>
					<text class="inner-text">双方就系统技术研发事宜达成一致，严格履行保密义务与知识产权归属条款。</text>
				</view>
			</view>
		</view>

		<!-- 3. 图片水印 -->
		<view class="section">
			<text class="section-title">3. 图片水印</text>
			<view class="card demo-container">
				<ste-watermark
					:fullPage="false"
					image="https://mdn.alipayobjects.com/huamei_7uahnr/afts/img/A*lkAoRbywo0oAAAAAAAAAAAAADrJ8AQ/original"
					:imageWidth="64"
					:imageHeight="64"
					:width="120"
					:height="100"
					:gapX="40"
					:gapY="40"
				/>
				<view class="demo-card-inner">
					<text class="inner-title">品牌徽标图片水印</text>
					<text class="inner-text">通过 image 属性传入图片地址，水印内容支持以图片作为重复单元均匀平铺。</text>
				</view>
			</view>
		</view>

		<!-- 4. 自定义旋转角度与间距 -->
		<view class="section">
			<text class="section-title">4. 自定义旋转角度 (35°) 与紧凑间距</text>
			<view class="card demo-container">
				<ste-watermark
					:fullPage="false"
					content="ST-DESIGN"
					:rotate="35"
					:gapX="24"
					:gapY="24"
					:width="100"
					:height="50"
				/>
				<view class="demo-card-inner">
					<text class="inner-title">紧凑正角度排版</text>
					<text class="inner-text">支持设置 rotate 角度（正角逆时针/负角顺时针）以及更密集的间距 gapX 与 gapY。</text>
				</view>
			</view>
		</view>

		<!-- 5. 自定义字体样式与配色 -->
		<view class="section">
			<text class="section-title">5. 自定义字体颜色与加粗</text>
			<view class="card demo-container">
				<ste-watermark
					:fullPage="false"
					content="OFFICIAL"
					:width="130"
					:height="60"
					:font="customFont"
				/>
				<view class="demo-card-inner">
					<text class="inner-title">高亮科技蓝主题水印</text>
					<text class="inner-text">通过 font 属性自定义水印字号、字体颜色及粗细。</text>
				</view>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	/**
	 * @file pages/demo/watermark/watermark.uvue
	 * @description Watermark 水印组件 Demo 演示页面
	 * 包含全屏水印与点击穿透测试、局部容器多行文本水印、图片水印、自定义角度及自定义主题样式演示。
	 */

	import type { WatermarkFont } from '@/uni_modules/stellar-ui-uvue/components/ste-watermark/types.uts'

	/** 是否展示全屏水印 */
	const showFullScreenWatermark = ref<boolean>(false)

	/** 点击测试计数 */
	const clickCount = ref<number>(0)

	/** 自定义科技蓝字体配置 */
	const customFont: WatermarkFont = {
		color: 'rgba(24, 144, 255, 0.28)',
		fontSize: 18,
		fontWeight: 'bold',
		fontStyle: 'normal',
		fontFamily: 'sans-serif',
		textAlign: 'center'
	}

	/**
	 * 切换全屏水印开启/关闭状态
	 */
	function toggleFullScreenWatermark() {
		showFullScreenWatermark.value = !showFullScreenWatermark.value
	}

	/**
	 * 交互验证按钮点击事件
	 * 证明全屏水印覆盖在页面最上层时，底层按钮仍然可以顺畅响应点击
	 */
	function handleTestClick() {
		clickCount.value++
		uni.showToast({
			title: '点击响应成功: ' + clickCount.value,
			icon: 'none'
		})
	}
</script>

<style>
	.page {
		flex: 1;
		padding: 30rpx;
		background-color: #f7f8fa;
	}

	.header {
		margin-bottom: 30rpx;
	}

	.title {
		font-size: 40rpx;
		font-weight: bold;
		color: #1f2329;
		margin-bottom: 12rpx;
	}

	.desc {
		font-size: 26rpx;
		color: #8f959e;
		line-height: 38rpx;
	}

	.section {
		margin-bottom: 40rpx;
	}

	.section-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #333333;
		margin-bottom: 16rpx;
	}

	.card {
		background-color: #ffffff;
		border-radius: 16rpx;
		padding: 24rpx;
	}

	.card-desc {
		font-size: 24rpx;
		color: #666666;
		margin-bottom: 20rpx;
	}

	.action-row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.btn {
		flex: 1;
		margin: 0 10rpx;
		font-size: 24rpx;
		height: 72rpx;
		line-height: 72rpx;
	}

	.primary-btn {
		background-color: #1890ff;
		color: #ffffff;
	}

	.test-btn {
		background-color: #00c250;
		color: #ffffff;
	}

	/* 局部水印宿主容器：必须设置 position: relative 与 overflow: hidden */
	.demo-container {
		position: relative;
		overflow: hidden;
		min-height: 260rpx;
	}

	.demo-card-inner {
		flex-direction: column;
	}

	.inner-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #1a1a1a;
		margin-bottom: 12rpx;
	}

	.inner-text {
		font-size: 26rpx;
		color: #555555;
		line-height: 40rpx;
		margin-bottom: 10rpx;
	}
</style>
