<template>
	<scroll-view scroll-y="true" class="page-container">
		<!-- 头部导航与功能简介 -->
		<view class="page-header">
			<text class="page-title">SelectSeat 在线选座</text>
			<text class="page-desc">基于高性能 2D Canvas 硬件渲染，支持万级网格、多点触控缩放与拖拽、过道空位镂空、售出锁定置灰、浮动行号数字轴及已选票夹联动。</text>
		</view>

		<view class="demo-content">
			<!-- 用例 1：标准影院购票选座 -->
			<view class="demo-card">
				<text class="card-title">1. 标准影院购票选座 (图例与实时票夹联动)</text>
				<text class="card-desc">双指缩放、单指平移、点击选座；左侧附带浮动行号轴，底部展示选票结果卡片与合计总价。</text>

				<!-- 图例说明区 -->
				<view class="legend-row">
					<view class="legend-item">
						<view class="legend-box available" />
						<text class="legend-text">可选</text>
					</view>
					<view class="legend-item">
						<view class="legend-box selected" />
						<text class="legend-text">已选</text>
					</view>
					<view class="legend-item">
						<view class="legend-box disabled" />
						<text class="legend-text">已售</text>
					</view>
					<view class="legend-item">
						<view class="legend-box couple" />
						<text class="legend-text">情侣座</text>
					</view>
				</view>

				<!-- 荧幕视觉指示区 -->
				<view class="screen-box">
					<view class="screen-line" />
					<text class="screen-title">1 号杜比全景声激光巨幕厅 (银幕中央)</text>
				</view>

				<!-- 选座主画布 -->
				<view class="seat-container">
					<ste-select-seat
						v-model="selectedSeats1"
						:rows="8"
						:cols="10"
						:width="canvasWidth"
						:height="320"
						:seats="customSeats1"
						@seat-click="onSeatClick"
						@move="onSeatMove"
					/>
				</view>

				<!-- 已选座位票夹面板 -->
				<view class="ticket-panel">
					<text class="ticket-panel-title">已选座位 ({{ selectedSeats1.length }}/4)</text>
					<view v-if="selectedSeats1.length > 0" class="ticket-tags-row">
						<view
							v-for="(item, index) in selectedSeats1"
							:key="index"
							class="ticket-tag"
							@click="removeSeat(index)"
						>
							<text class="ticket-tag-text">{{ item.row + 1 }}排{{ item.col + 1 }}座</text>
							<text class="ticket-tag-close">×</text>
						</view>
					</view>
					<text v-else class="ticket-empty-text">请在上方座位图挑选心仪的座位</text>

					<!-- 底部结算栏 -->
					<view class="checkout-row">
						<view class="checkout-info">
							<text class="price-symbol">¥</text>
							<text class="price-value">{{ selectedSeats1.length * 45 }}</text>
							<text class="price-label">（单价 ¥45/座）</text>
						</view>
						<ste-button
							:round="true"
							background="#0090FF"
							color="#FFFFFF"
							:disabled="selectedSeats1.length == 0"
							@click="onConfirmBuy"
						>
							立即购票
						</ste-button>
					</view>
				</view>
			</view>

			<!-- 用例 2：VIP 贵宾包厢自定义配色 -->
			<view class="demo-card">
				<text class="card-title">2. VIP 贵宾包厢 (奢华黑金配色)</text>
				<text class="card-desc">自定义背景色、边框色、选中色与禁用色，满足剧院、音乐会等高品质场景需求。</text>
				<view class="seat-container">
					<ste-select-seat
						v-model="selectedSeats2"
						:rows="5"
						:cols="8"
						:width="canvasWidth"
						:height="260"
						:seats="vipSeats"
						bgColor="#2C2C2C"
						borderColor="#444444"
						selectedBgColor="#D4AF37"
						selectedColor="#1A1A1A"
						disabledBgColor="#555555"
					/>
				</view>
				<view class="card-tip">
					<text class="card-tip-text">VIP 已选：{{ selectedSeats2.length }} 个座席</text>
				</view>
			</view>

			<!-- 交互日志输出 -->
			<view class="demo-card">
				<text class="card-title">视口手势实时监控</text>
				<view class="log-box">
					<text class="log-text">{{ moveLog }}</text>
				</view>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { ref, onMounted } from 'vue'
	import {
		SteSelectSeatValue,
		SteSelectSeatItem,
		SteSelectSeatMoveEvent,
	} from '../../../uni_modules/stellar-ui-uvue/components/ste-select-seat/types.uts'

	// 动态计算画布宽度（适配整屏边距）
	const canvasWidth = ref<number>(340)

	// 用例 1：已选座位数据
	const selectedSeats1 = ref<SteSelectSeatValue[]>([
		{ row: 4, col: 4 } as SteSelectSeatValue,
		{ row: 4, col: 5 } as SteSelectSeatValue,
	])

	// 用例 1：自定义影院座位（已售、通道空位与情侣座）
	const customSeats1 = ref<SteSelectSeatItem[]>([
		// 中间过道走廊空位
		{ row: 0, col: 4, empty: true } as SteSelectSeatItem,
		{ row: 1, col: 4, empty: true } as SteSelectSeatItem,
		{ row: 2, col: 4, empty: true } as SteSelectSeatItem,
		{ row: 3, col: 4, empty: true } as SteSelectSeatItem,
		{ row: 4, col: 4, empty: true } as SteSelectSeatItem,
		{ row: 5, col: 4, empty: true } as SteSelectSeatItem,
		{ row: 6, col: 4, empty: true } as SteSelectSeatItem,
		{ row: 7, col: 4, empty: true } as SteSelectSeatItem,
		// 已售出不可选座位
		{ row: 2, col: 2, disabled: true } as SteSelectSeatItem,
		{ row: 2, col: 3, disabled: true } as SteSelectSeatItem,
		{ row: 3, col: 6, disabled: true } as SteSelectSeatItem,
		{ row: 3, col: 7, disabled: true } as SteSelectSeatItem,
		{ row: 5, col: 2, disabled: true } as SteSelectSeatItem,
		// 最后一排情侣座
		{ row: 7, col: 0, bgColor: '#FFF0F5', borderColor: '#FFB6C1', selectedBgColor: '#FF69B4' } as SteSelectSeatItem,
		{ row: 7, col: 1, bgColor: '#FFF0F5', borderColor: '#FFB6C1', selectedBgColor: '#FF69B4' } as SteSelectSeatItem,
		{ row: 7, col: 8, bgColor: '#FFF0F5', borderColor: '#FFB6C1', selectedBgColor: '#FF69B4' } as SteSelectSeatItem,
		{ row: 7, col: 9, bgColor: '#FFF0F5', borderColor: '#FFB6C1', selectedBgColor: '#FF69B4' } as SteSelectSeatItem,
	])

	// 用例 2：VIP 贵宾座
	const selectedSeats2 = ref<SteSelectSeatValue[]>([
		{ row: 1, col: 3 } as SteSelectSeatValue,
	])

	const vipSeats = ref<SteSelectSeatItem[]>([
		{ row: 0, col: 0, disabled: true } as SteSelectSeatItem,
		{ row: 0, col: 7, disabled: true } as SteSelectSeatItem,
		{ row: 2, col: 3, empty: true } as SteSelectSeatItem,
		{ row: 2, col: 4, empty: true } as SteSelectSeatItem,
	])

	// 手势监控日志
	const moveLog = ref<string>('滑动或双指缩放画布可在此观察物理视口变换参数')

	/**
	 * 移除已选座位
	 */
	function removeSeat(index : number) {
		selectedSeats1.value.splice(index, 1)
	}

	/**
	 * 座位点击响应
	 */
	function onSeatClick(seat : SteSelectSeatItem) {
		moveLog.value = `[点击座位] ${seat.row + 1}排${seat.col + 1}座`
	}

	/**
	 * 视口平移与缩放监听
	 */
	function onSeatMove(e : SteSelectSeatMoveEvent) {
		moveLog.value = `[视口手势] scale: ${e.scale.toFixed(2)}, tx: ${e.translateX.toFixed(1)}, ty: ${e.translateY.toFixed(1)}`
	}

	/**
	 * 确认购票
	 */
	function onConfirmBuy() {
		uni.showToast({
			title: `成功选定 ${selectedSeats1.value.length} 张电影票`,
			icon: 'success',
		})
	}

	onMounted(() => {
		// 根据屏幕窗口宽度计算最佳画布宽度
		const sys = uni.getWindowInfo()
		const screenW = sys.windowWidth
		if (screenW > 40) {
			canvasWidth.value = screenW - 32
		}
	})
</script>

