	margin-bottom: 30rpx;
}

.demo-item-title {
	font-size: 28rpx;
	font-weight: bold;
	margin-bottom: 16rpx;
	color: #333333;
}

.btn-row {
	margin-bottom: 12rpx;
}

.calendar-card {
	background-color: #ffffff;
	border-radius: 16rpx;
	overflow: hidden;
	padding: 12rpx;
	border: 1rpx solid #e8e8e8;
}
</style>
