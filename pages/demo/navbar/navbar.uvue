</template>

<script setup lang="uts">
	/**
	 * @file navbar.uvue
	 * @description Navbar 页面顶部导航栏 - uni-app x / UTS 演示页面
	 */
	import { ref } from 'vue'

	// 操作反馈日志
	const logText = ref('等待交互操作中...')

	// ==================== 页面导航栏回调 ====================
	function onPageNavbarBack() {
		logText.value = '触发了页面主导航栏返回事件'
	}

	function onShareClick() {
		logText.value = '点击了主导航栏右侧分享按钮'
	}

	// ==================== 演示卡片事件回调 ====================
	function onDemoBack(tag : string) {
		logText.value = `已触发【${tag}】返回按钮点击事件 (backClick)`
	}

	function onRightAction(action : string) {
		logText.value = `点击了插槽右侧操作项：【${action}】`
	}

	function onInterceptBack() {
		logText.value = '触发了【返回拦截】！已阻止默认返回，您可在此执行表单保存或确认弹窗'
	}
</script>

