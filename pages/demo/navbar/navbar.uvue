					<text class="card-desc">可通过 #default 插槽嵌入搜索框或业务组件，通过 #right 拓展功能按钮。</text>
					<view class="nav-preview-box">
						<ste-navbar
							:safeAreaInsetTop="false"
							:fixed="false"
