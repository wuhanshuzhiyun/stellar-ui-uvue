					<text class="card-desc">支持隐藏返回按钮、胶囊背景填充、边框色、自定义返回图标与透明度调节。</text>

					<!-- 2.1 隐藏返回键 -->
					<view class="nav-preview-box mb-16">
						<ste-navbar
							title="隐藏返回键导航"
							:autoBack="false"
							:titleAlignment="1"
							:safeAreaInsetTop="false"
							:fixed="false"
							backgroundColor="#f9fafb"
						/>
					</view>

					<!-- 2.2 胶囊边框高亮样式 -->
