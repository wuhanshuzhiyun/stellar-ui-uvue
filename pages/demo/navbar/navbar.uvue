		>
			<template #right>
				<view class="nav-right-btn" @click="onShareClick">
					<ste-icon code="&#xe677;" :size="32" color="#333333" />
				</view>
			</template>
		</ste-navbar>

		<scroll-view scroll-y="true" class="page-container">
			<!-- 头部导航与功能简介 -->
			<view class="page-header">
				<text class="page-title">Navbar 页面导航栏</text>
				<text class="page-desc">常用于页面顶部提供导航与返回功能，支持状态栏安全区自适应、居左/居中排版、返回键定制及丰富插槽扩展。</text>
