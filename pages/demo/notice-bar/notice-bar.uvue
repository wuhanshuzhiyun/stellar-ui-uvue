	background-color: #e6f7ff;
	border-radius: 12rpx;
	padding: 10rpx 20rpx;
	border: 1px solid #91d5ff;
}

.slot-action {
	display: flex;
	flex-direction: row;
	align-items: center;
}

.slot-action-text {
	font-size: 24rpx;
	color: #1890ff;
	margin-right: 4rpx;
}

.result-box {
	margin-top: 16rpx;
	padding: 16rpx 20rpx;
	background-color: #f0f5ff;
	border-radius: 10rpx;
	border-left: 6rpx solid #2f54eb;
}

.result-text {
	font-size: 24rpx;
	color: #1d39c4;
}

.footer-space {
	height: 60rpx;
}
</style>
