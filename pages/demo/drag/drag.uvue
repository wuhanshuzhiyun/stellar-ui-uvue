<template>
	<scroll-view direction="vertical" class="page">
		<view class="section">
			<text class="section-title">基础拖拽</text>
			<view class="drag-area">
				<ste-drag @start="onStart" @end="onEnd">
					<view class="drag-box">
						<text class="drag-text">拖我</text>
					</view>
				</ste-drag>
			</view>
		</view>

		<view class="section">
			<text class="section-title">仅水平拖拽</text>
			<view class="drag-area">
				<ste-drag direction="x">
					<view class="drag-box">
						<text class="drag-text">水平</text>
					</view>
				</ste-drag>
			</view>
