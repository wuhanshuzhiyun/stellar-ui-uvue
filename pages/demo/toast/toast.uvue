	font-size: 26rpx;
	color: #666666;
	line-height: 38rpx;
}

.demo-content {
	display: flex;
	flex-direction: column;
	padding-bottom: 80rpx;
}

.demo-card {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 24rpx;
	margin-bottom: 24rpx;
	box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.card-title {
	font-size: 30rpx;
	font-weight: bold;
	color: #1a1a1a;
	margin-bottom: 8rpx;
}

.card-desc {
	font-size: 24rpx;
	color: #888888;
	line-height: 34rpx;
	margin-bottom: 20rpx;
}

.btn-group {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}

.btn-grid {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}

.btn-item {
	margin-right: 16rpx;
	margin-bottom: 16rpx;
}

.log-box {
	margin-top: 10rpx;
	background-color: #f0f2f5;
	border-radius: 10rpx;
	padding: 16rpx 20rpx;
}

.log-title {
	font-size: 24rpx;
	font-weight: bold;
	color: #555555;
	margin-bottom: 6rpx;
}

.log-content {
	font-size: 24rpx;
	color: #007aff;
	line-height: 34rpx;
}
</style>
