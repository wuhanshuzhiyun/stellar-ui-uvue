</template>

<script setup lang="uts">
/**
 * Price 价格展示组件 Demo 页面
 */
function customFormatter(val: any): string {
	const n = parseFloat(val != null ? val.toString() : '0')
	if (n >= 10000) {
		const wan = (n / 10000).toFixed(1)
		return `${wan}万`
	}
	return n.toString()
}
</script>

