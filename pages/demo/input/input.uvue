</template>

<script setup lang="uts">
	defineOptions({ name: 'demo-input' })

	/** 只保留数字，验证 filter 前置过滤 */
	function onlyNumber(value : string) : string {
		return value.replace(/[^\d]/g, '')
	}
</script>

