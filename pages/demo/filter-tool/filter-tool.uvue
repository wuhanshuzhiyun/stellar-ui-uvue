<template>
	<scroll-view scroll-y="true" class="page-root">
		<!-- 顶部导航标题区 -->
		<view class="demo-header">
			<text class="demo-title">FilterTool 多维筛选工具</text>
			<text class="demo-subtitle">支持按钮网格、单选勾选与日历模式，提供分类左右联动定位、折叠展开与自定义输入框筛选能力</text>
		</view>

		<!-- 示例 1：基础多维筛选（按钮网格模式） -->
		<view class="demo-card">
			<text class="card-title">1. 基础多维筛选 (按钮网格)</text>
			<text class="card-desc">支持单选、多选（商品分类）、首行折叠展开（商品状态）与自定义输入（价格区间）</text>
			<view class="card-content">
				<ste-filter-tool
					:data="basicFilters"
					:value="selectedBasicValues"
					@confirm="onBasicConfirm"
					@reset="onBasicReset"
					@itemClick="onBasicItemClick"
				>
					<view class="trigger-box">
						<text class="trigger-label">点击打开多维筛选</text>
						<ste-icon code="&#xe6c7;" color="#0275ff" :size="24"></ste-icon>
					</view>
				</ste-filter-tool>

				<!-- 选中的筛选值展示区 -->
				<view class="result-box" v-if="basicResultText != ''">
					<text class="result-title">当前已选值：</text>
					<text class="result-content">{{ basicResultText }}</text>
				</view>
			</view>
		</view>

		<!-- 示例 2：单选勾选列表模式 -->
		<view class="demo-card">
			<text class="card-title">2. 单选勾选列表模式</text>
			<text class="card-desc">filterType='checkbox' 模式，适合排序、建议量等单选排他项</text>
			<view class="card-content">
				<ste-filter-tool
					filterType="checkbox"
					:data="checkboxFilters"
					@confirm="onCheckboxConfirm"
				>
					<view class="trigger-box">
						<text class="trigger-label">点击打开单选列表</text>
						<ste-icon code="&#xe6c7;" color="#0275ff" :size="24"></ste-icon>
					</view>
				</ste-filter-tool>

				<view class="result-box" v-if="checkboxResultText != ''">
					<text class="result-title">当前已选值：</text>
					<text class="result-content">{{ checkboxResultText }}</text>
				</view>
			</view>
		</view>

		<!-- 示例 3：自定义列数排版 (2列 / 4列) -->
		<view class="demo-card">
			<text class="card-title">3. 自定义网格列数</text>
			<text class="card-desc">通过 rowCount 配置不同行数的自适应列宽（例如 2 列与 4 列）</text>
			<view class="card-content">
				<ste-filter-tool :data="customRowFilters" activeColor="#00b578">
					<view class="trigger-box green-trigger">
						<text class="trigger-label green-label">绿色主题 & 2/4列排版</text>
						<ste-icon code="&#xe6c7;" color="#00b578" :size="24"></ste-icon>
					</view>
				</ste-filter-tool>
			</view>
		</view>

		<!-- 示例 4：禁用确认按钮状态控制 -->
		<view class="demo-card">
			<text class="card-title">4. 禁用确认按钮联动</text>
			<text class="card-desc">初始禁用确认操作，检测到选中任意筛选项后自动激活解除禁用</text>
			<view class="card-content">
				<ste-filter-tool
					filterType="checkbox"
					:data="disableTestFilters"
					:confirmDisabled="isConfirmDisabled"
					@itemClick="onDisableTestItemClick"
					@reset="onDisableTestReset"
				>
					<view class="trigger-box orange-trigger">
						<text class="trigger-label orange-label">{{ isConfirmDisabled ? '需先选择选项' : '已可确认' }}</text>
						<ste-icon code="&#xe6c7;" color="#fa8c16" :size="24"></ste-icon>
					</view>
				</ste-filter-tool>
			</view>
		</view>

		<!-- 示例 5：顶部偏移 (offsetTop) 与实例方法 (closeMenu) 演示 -->
		<view class="demo-card">
			<text class="card-title">5. 顶部偏移 (offsetTop) 与实例方法 (closeMenu)</text>
			<text class="card-desc">配置 :offsetTop="80" 调整下拉菜单展开距离，并支持外部调用组件实例方法 closeMenu() 主动收起</text>
			<view class="card-content">
				<ste-filter-tool
					ref="filterToolRef"
					:offsetTop="80"
					filterType="checkbox"
					:data="offsetTestFilters"
				>
					<view class="trigger-box">
						<text class="trigger-label">点击展开带 offsetTop 的筛选器</text>
						<ste-icon code="&#xe6c7;" color="#0275ff" :size="24"></ste-icon>
					</view>
				</ste-filter-tool>
				<button class="action-btn" @click="handleManualClose">外部调用 closeMenu() 主动收起菜单</button>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
/**
 * @file filter-tool.uvue
 * @description ste-filter-tool 多维筛选工具 原生演示页面
 */
import { FilterItem, FilterValue } from '@/uni_modules/stellar-ui-uvue/components/ste-filter-tool/constants.uts';

/** 示例 1：基础多维筛选选项配置 */
const basicFilters = ref<FilterItem[]>([
	{
		title: '商品分类',
		key: 'category',
		multiple: true,
		rowCount: 3,
		children: [
			{ title: '数码家电', value: 'digital' },
			{ title: '服饰鞋包', value: 'clothes' },
			{ title: '美妆个护', value: 'beauty' },
			{ title: '母婴玩具', value: 'baby' },
			{ title: '生鲜水果', value: 'fruit' },
			{ title: '图书音像', value: 'book' }
		]
	},
	{
		title: '商品状态',
		key: 'status',
		expandCount: 1,
		rowCount: 3,
		children: [
			{ title: '在售中', value: 'on_sale' },
			{ title: '已售罄', value: 'sold_out' },
			{ title: '预售中', value: 'presale' },
			{ title: '待上架', value: 'pending' },
			{ title: '库存预警', value: 'warning' },
			{ title: '促销中', value: 'discount' }
		]
	},
	{
		title: '关键词搜索',
		key: 'keyword',
		type: 'input',
		config: {
			value: '',
			placeholder: '输入商品名或编号',
			maxLength: 50,
			clearable: true
		}
	},
	{
		title: '支付方式',
		key: 'payment',
		children: [
			{ title: '微信支付', value: 'wechat' },
			{ title: '支付宝', value: 'alipay' },
			{ title: '银联云闪付', value: 'unionpay' }
		]
	}
]);

const selectedBasicValues = ref<FilterValue[]>([]);
const basicResultText = ref<string>('');

function onBasicConfirm(values : FilterValue[]) {
	selectedBasicValues.value = values;
	const parts : string[] = [];
	for (let i = 0; i < values.length; i++) {
		const v = values[i];
		parts.push(`${v.title ?? v.key}: [${v.values.join(',')}]`);
	}
	basicResultText.value = parts.join('；');
}

function onBasicReset() {
	selectedBasicValues.value = [];
	basicResultText.value = '';
}

function onBasicItemClick(item : FilterValue) {
	// 实时记录最新点击状态
}

/** 示例 2：单选勾选列表配置 */
const checkboxFilters = ref<FilterItem[]>([
	{
		title: '综合排序',
		key: 'sort',
		children: [
			{ title: '综合推荐', value: 'recommend' },
			{ title: '价格从低到高', value: 'price_asc' },
			{ title: '价格从高到低', value: 'price_desc' },
			{ title: '销量最高优先', value: 'sales' }
		]
	},
	{
		title: '配送方式',
		key: 'shipping',
		children: [
			{ title: '京东自营配送', value: 'jd_self' },
			{ title: '同城极速免邮', value: 'city_free' },
			{ title: '门店自提', value: 'self_pickup' }
		]
	}
]);

const checkboxResultText = ref<string>('');

function onCheckboxConfirm(values : FilterValue[]) {
	const parts : string[] = [];
	for (let i = 0; i < values.length; i++) {
		const v = values[i];
		parts.push(`${v.title ?? v.key}: [${v.values.join(',')}]`);
	}
	checkboxResultText.value = parts.join('；');
}

/** 示例 3：2列与4列配置 */
const customRowFilters = ref<FilterItem[]>([
	{
		title: '供货大区 (2列)',
		key: 'region',
		rowCount: 2,
		children: [
			{ title: '华东大区基地', value: 'east' },
			{ title: '华北大区基地', value: 'north' },
			{ title: '华南大区基地', value: 'south' },
			{ title: '西南大区基地', value: 'west' }
		]
	},
	{
		title: '快递渠道 (4列)',
		key: 'express',
		rowCount: 4,
		children: [
			{ title: '顺丰', value: 'sf' },
			{ title: '京东', value: 'jd' },
			{ title: '中通', value: 'zto' },
			{ title: '圆通', value: 'yto' },
			{ title: '申通', value: 'sto' },
			{ title: '韵达', value: 'yd' },
			{ title: '极兔', value: 'jt' },
			{ title: '邮政', value: 'ems' }
		]
	}
]);

/** 示例 4：禁用确认联动 */
const disableTestFilters = ref<FilterItem[]>([
	{
		title: '必选属性',
		key: 'required_type',
		children: [
			{ title: '标准版 (已验证)', value: 'standard' },
			{ title: '尊享版 (需审批)', value: 'vip' }
		]
	}
]);

const isConfirmDisabled = ref<boolean>(true);

function onDisableTestItemClick(_item : FilterValue) {
	isConfirmDisabled.value = false;
}

function onDisableTestReset() {
	isConfirmDisabled.value = true;
}

/** 示例 5：filter-tool 实例引用以调用 closeMenu */
const filterToolRef = ref<ComponentPublicInstance | null>(null);

/** 示例 5：测试顶部偏移量与选项数据 */
const offsetTestFilters = ref<FilterItem[]>([
	{
		title: '配送方式',
		key: 'delivery',
		children: [
			{ title: '即时送达 (1小时内)', value: 'instant' },
			{ title: '同城当日达', value: 'same_day' },
			{ title: '次日标准达', value: 'next_day' }
		]
	}
]);

/** 外部调用 filter-tool 导出的 closeMenu() 方法收起面板 */
function handleManualClose() {
	if (filterToolRef.value != null) {
		const comp = filterToolRef.value!;
		comp.$callMethod('closeMenu');
	}
}
</script>

<style lang="scss" scoped>
.page-root {
	flex: 1;
	background-color: #f7f8fa;
	padding: 24rpx;
}

.demo-header {
	margin-bottom: 24rpx;

	.demo-title {
		font-size: 38rpx;
		font-weight: bold;
		color: #1a1a1a;
	}

	.demo-subtitle {
		margin-top: 8rpx;
		font-size: 24rpx;
		color: #8a8a8a;
		line-height: 36rpx;
	}
}

.demo-card {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 24rpx;
	margin-bottom: 24rpx;

	.card-title {
		font-size: 30rpx;
		font-weight: 600;
		color: #333333;
		margin-bottom: 6rpx;
	}

	.card-desc {
		font-size: 24rpx;
		color: #999999;
		margin-bottom: 20rpx;
		line-height: 34rpx;
	}

	.card-content {
		display: flex;
		flex-direction: column;
		background-color: #f2f3f5;
		padding: 20rpx;
		border-radius: 12rpx;
	}
}

.trigger-box {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	background-color: #ffffff;
	padding: 20rpx 28rpx;
	border-radius: 10rpx;
	border: 1rpx solid #e0e6ed;

	.trigger-label {
		font-size: 28rpx;
		color: #0275ff;
		font-weight: 500;
	}
}

.green-trigger {
	border-color: #b7eb8f;
	.green-label {
		color: #00b578;
	}
}

.orange-trigger {
	border-color: #ffd591;
	.orange-label {
		color: #fa8c16;
	}
}

.result-box {
	margin-top: 16rpx;
	padding: 16rpx;
	background-color: #eef4ff;
	border-radius: 8rpx;
	display: flex;
	flex-direction: column;

	.result-title {
		font-size: 24rpx;
		font-weight: bold;
		color: #0275ff;
		margin-bottom: 6rpx;
	}

	.result-content {
		font-size: 24rpx;
		color: #333333;
		line-height: 34rpx;
	}
}

.action-btn {
	margin-top: 20rpx;
	background-color: #0275ff;
	color: #ffffff;
	font-size: 26rpx;
	border-radius: 8rpx;
	line-height: 72rpx;
	height: 72rpx;
}
</style>
