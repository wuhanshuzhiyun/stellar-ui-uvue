<template>
	<scroll-view direction="vertical" class="page">
		<!-- 顶部标题 -->
		<view class="header">
			<text class="title">ReadMore 展开更多</text>
			<text class="desc">用于长图文内容折叠收起一部分，超出指定高度时底部渐变遮罩并展示操作按钮。</text>
		</view>

		<!-- 1. 基础用法 -->
		<view class="section">
			<text class="section-title">1. 基础用法 (超出 400rpx 自动折叠)</text>
			<view class="demo-card">
				<ste-read-more>
					<text class="article-text">{{ longArticle1 }}</text>
				</ste-read-more>
			</view>
		</view>

		<!-- 2. 展开后支持收起 -->
		<view class="section">
			<text class="section-title">2. 展开后显示收起按钮 (toggle=true)</text>
			<view class="demo-card">
				<ste-read-more :toggle="true" @open="onOpen" @close="onClose">
					<text class="article-text">{{ longArticle2 }}</text>
				</ste-read-more>
			</view>
		</view>

		<!-- 3. 短文本自适应 -->
		<view class="section">
			<text class="section-title">3. 短文本自适应 (未超出高度不出现按钮)</text>
			<view class="demo-card">
				<ste-read-more :showHeight="300">
					<text class="article-text">这是一段简短的通知内容，未达到折叠高度限制，组件会自动全量展示并不渲染底部的展开操作栏。</text>
				</ste-read-more>
			</view>
		</view>

		<!-- 4. 自定义折叠高度与文案配色 -->
		<view class="section">
			<text class="section-title">4. 自定义高度(240rpx)与主题色</text>
			<view class="demo-card">
				<ste-read-more
					:showHeight="240"
					:toggle="true"
					closeText="阅读琵琶行全诗"
					openText="折叠诗词"
					color="#1890ff"
					:fontSize="28"
				>
					<text class="article-text">{{ longArticle1 }}</text>
				</ste-read-more>
			</view>
		</view>

		<!-- 5. 异步数据加载与 init 方法 -->
		<view class="section">
			<text class="section-title">5. 异步内容动态加载 (调用 init)</text>
			<view class="demo-card">
				<ste-read-more ref="readMoreRef" :toggle="true">
					<text class="article-text" v-if="asyncArticle != ''">{{ asyncArticle }}</text>
					<text class="loading-placeholder" v-else>正在模拟异步网络请求加载大段文本...</text>
				</ste-read-more>
			</view>
		</view>

		<!-- 底部留白 -->
		<view class="footer-space"></view>
	</scroll-view>
</template>

<script setup lang="uts">
	/**
	 * @file read-more.uvue
	 * @description ReadMore 展开更多全场景交互式演示 Demo
	 */
	import { ref, onMounted, nextTick } from 'vue'

	const longArticle1 = ref(
		'浔阳江头夜送客，枫叶荻花秋瑟瑟。主人下马客在船，举酒欲饮无管弦。醉不成欢惨将别，别时茫茫江浸月。忽闻水上琵琶声，主人忘归客不发。寻声暗问弹者谁，琵琶声停欲语迟。移船相近邀相见，添酒回灯重开宴。千呼万唤始出来，犹抱琵琶半遮面。转轴拨弦三两声，未成曲调先有情。弦弦掩抑声声思，似诉平生不得志。低眉信手续续弹，说尽心中无限事。轻拢慢捻抹复挑，初为《霓裳》后《六幺》。大弦嘈嘈如急雨，小弦切切如私语。嘈嘈切切错杂弹，大珠小珠落玉盘。'
	)

	const longArticle2 = ref(
		'间关莺语花底滑，幽咽泉流冰下难。冰泉冷涩弦凝绝，凝绝不通声暂歇。别有幽愁暗恨生，此时无声胜有声。银瓶乍破水浆迸，铁骑突出刀枪鸣。曲终收拨当心画，四弦一声如裂帛。东船西舫悄无言，唯见江心秋月白。沉吟放拨插弦中，整顿衣裳起敛容。自言本是京城女，家在虾蟆陵下住。十三学得琵琶成，名属教坊第一部。曲罢曾教善才服，妆成每被秋娘妒。五陵年少争缠头，一曲红绡不知数。'
	)

	const asyncArticle = ref('')
	const readMoreRef = ref<SteReadMoreComponentPublicInstance | null>(null)

	function onOpen() {
		uni.showToast({
			title: '已展开全文',
			icon: 'none',
		})
	}

	function onClose() {
		uni.showToast({
			title: '已收起内容',
			icon: 'none',
		})
	}

	onMounted(() => {
		// 模拟网络请求 1.2 秒后返回长文本
		setTimeout(() => {
			asyncArticle.value =
				'【异步加载成功】感我此言良久立，却坐促弦弦转急。凄凄不似向前声，满座重闻皆掩泣。座中泣下谁最多？江州司马青衫湿。' +
				longArticle1.value
			nextTick(() => {
				readMoreRef.value?.init()
			})
		}, 1200)
	})
</script>

<style>
.page {
	padding: 24rpx;
	background-color: #f7f8fa;
	flex: 1;
}

.header {
	margin-bottom: 30rpx;
}

.title {
	font-size: 38rpx;
	font-weight: bold;
	color: #1f2329;
}

.desc {
	font-size: 26rpx;
	color: #8f959e;
	margin-top: 10rpx;
	line-height: 1.5;
}

.section {
	margin-bottom: 36rpx;
}

.section-title {
	font-size: 30rpx;
	font-weight: bold;
	color: #1f2329;
	margin-bottom: 16rpx;
}

.demo-card {
	padding: 28rpx;
	background-color: #ffffff;
	border-radius: 16rpx;
	box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.article-text {
	font-size: 28rpx;
	color: #333333;
	line-height: 1.8;
}

.loading-placeholder {
	font-size: 26rpx;
	color: #999999;
	font-style: italic;
}

.footer-space {
	height: 80rpx;
}
</style>
