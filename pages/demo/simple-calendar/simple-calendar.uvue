		color: #888888;
		margin-bottom: 20rpx;
		line-height: 34rpx;
	}

	.card-inner {
		background-color: #f5f6f8;
		border-radius: 12rpx;
		padding: 20rpx 16rpx;
		display: flex;
	}

	.flex-row-start {
		flex-direction: row;
		justify-content: flex-start;
		align-items: center;
	}

	.mb-16 {
		margin-bottom: 16rpx;
	}

	.mb-24 {
		margin-bottom: 24rpx;
	}

	.mt-16 {
		margin-top: 16rpx;
	}

	.ml-16 {
		margin-left: 16rpx;
	}

	/* 实时状态提示框 */
	.status-panel {
		background-color: #eff6ff;
