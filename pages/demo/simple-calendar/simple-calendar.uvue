	/* 颜色展示行 */
	.color-row {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.color-item {
		background-color: #f5f6f8;
		border-radius: 12rpx;
		padding: 20rpx 16rpx;
	}

	/* 控制按钮网格 */
	.btn-grid {
