	}

	/* 演示卡片列表区 */
	.demo-content {
		padding: 0 24rpx 48rpx;
	}

	.demo-card {
		background-color: #ffffff;
		border-radius: 16rpx;
		padding: 32rpx;
		margin-bottom: 24rpx;
	}

	.card-title {
		font-size: 30rpx;
		font-weight: 600;
		color: #333333;
		margin-bottom: 8rpx;
	}

	.card-desc {
		font-size: 24rpx;
		color: #999999;
		line-height: 34rpx;
		margin-bottom: 20rpx;
	}

	/* 卡片底色衬托盒（浅灰色背景衬托白色搜索框） */
	.card-inner {
		background-color: #f3f4f6;
		border-radius: 16rpx;
		padding: 16rpx;
	}

	/* 右侧搜索按钮 */
	.slot-search-btn {
		margin-left: 16rpx;
	}

	/* 右侧图标组 */
	.slot-icons-wrap {
		flex-direction: row;
		align-items: center;
		margin-left: 16rpx;
	}

	.slot-icon-item {
		width: 48rpx;
		height: 48rpx;
		justify-content: center;
		align-items: center;
	}

	.ml-12 {
		margin-left: 12rpx;
	}

	/* 操作日志盒子 */
	.log-box {
		background-color: #f9f9f9;
		border-radius: 8rpx;
		padding: 20rpx;
		border-left-width: 6rpx;
		border-left-style: solid;
		border-left-color: #0090ff;
	}

	.log-text {
		font-size: 24rpx;
		color: #555555;
		line-height: 36rpx;
	}
</style>
