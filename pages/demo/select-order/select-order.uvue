	flex-direction: column;
}

.demo-card {
	background-color: #FFFFFF;
	border-radius: 16rpx;
	padding: 24rpx;
	margin-bottom: 24rpx;
	overflow: visible;
}

.card-title {
	font-size: 30rpx;
	font-weight: bold;
	color: #222222;
	margin-bottom: 8rpx;
}

