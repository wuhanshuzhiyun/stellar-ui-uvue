	font-size: 24rpx;
	color: #8C8C8C;
	line-height: 34rpx;
	margin-bottom: 20rpx;
}

.card-inner {
	background-color: #F8F9FB;
	border-radius: 12rpx;
	padding: 8rpx;
	overflow: visible;
}

.card-tip {
	margin-top: 14rpx;
}

