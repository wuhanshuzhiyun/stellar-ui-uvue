.demo-header {
	margin-bottom: 24rpx;
}

.demo-title {
	font-size: 36rpx;
	font-weight: bold;
	color: #1a1a1a;
}

.demo-subtitle {
	font-size: 24rpx;
	color: #8c8c8c;
	margin-top: 8rpx;
}

/* 示例卡片容器 */
.demo-card {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 24rpx;
	margin-bottom: 24rpx;
}

.card-title {
	font-size: 28rpx;
	font-weight: bold;
	color: #262626;
}

.card-desc {
	font-size: 22rpx;
	color: #8c8c8c;
	margin-top: 6rpx;
	margin-bottom: 16rpx;
}

/* 模拟输入框外观 */
.input-display {
	height: 80rpx;
	background-color: #f9f9fb;
	border-radius: 12rpx;
	padding-left: 20rpx;
	padding-right: 20rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	border-width: 1px;
	border-style: solid;
	border-color: #e5e6eb;
}

.input-label {
	font-size: 26rpx;
	color: #4e5969;
}

.input-value {
	font-size: 28rpx;
	font-weight: bold;
	color: #1f2329;
}

.input-placeholder {
	font-size: 26rpx;
	color: #c9cdd4;
}

/* 安全内嵌显示区 */
.safe-display {
	padding: 16rpx 20rpx;
	background-color: #f2f3f5;
	border-radius: 8rpx;
	margin-bottom: 16rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
}

.safe-display-label {
	font-size: 24rpx;
	color: #4e5969;
}

.safe-display-val {
	font-size: 28rpx;
	font-weight: bold;
	color: #0090ff;
}

/* 内嵌键盘外框 */
.keyboard-page-box {
	border-radius: 16rpx;
	overflow: hidden;
	background-color: #f2f3f5;
}
</style>
