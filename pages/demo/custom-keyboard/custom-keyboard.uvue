<template>
	<scroll-view scroll-y="true" class="page-root">
		<!-- 顶部导航标题区 -->
		<view class="demo-header">
			<text class="demo-title">CustomKeyboard 定制键盘</text>
			<text class="demo-subtitle">针对移动支付、收银结账、折扣计算与身份证实名认证的高级业务键盘</text>
		</view>

		<!-- 示例 1：基础数字键盘 (带小数点自定义键) -->
		<view class="demo-card">
			<text class="card-title">基础数字键盘</text>
			<text class="card-desc">支持输入金额、小数点自定义按键、长按删除与确认回调</text>
			<view class="input-display" @click="showNumber = true">
				<text class="input-label">付款金额：</text>
				<text class="input-value" v-if="numberVal != ''">¥ {{ numberVal }}</text>
				<text class="input-placeholder" v-else>点击唤起数字键盘输入金额</text>
			</view>
			<ste-custom-keyboard
				v-model="numberVal"
				v-model:show="showNumber"
				:custom-keys="['.']"
				confirm-text="支付"
				@confirm="onNumberConfirm"
			/>
		</view>

		<!-- 示例 2：身份证实名键盘 (自动补充 X 键) -->
		<view class="demo-card">
			<text class="card-title">身份证键盘</text>
			<text class="card-desc">自动补充大写 X 字母按键，限定 18 位长度，适用于实名认证场景</text>
			<view class="input-display" @click="showIdCard = true">
				<text class="input-label">身份证号：</text>
				<text class="input-value" v-if="idCardVal != ''">{{ idCardVal }}</text>
				<text class="input-placeholder" v-else>点击输入 18 位身份证号码</text>
			</view>
			<ste-custom-keyboard
				type="idcard"
				v-model="idCardVal"
				v-model:show="showIdCard"
				:maxlength="18"
				confirm-text="完成"
				@confirm="onIdCardConfirm"
			/>
		</view>

		<!-- 示例 3：折扣快捷键盘 (顶部横向折扣胶囊) -->
		<view class="demo-card">
			<text class="card-title">折扣键盘</text>
			<text class="card-desc">键盘上方横向展示常用折扣胶囊，点击胶囊一键快捷填入折扣率</text>
			<view class="input-display" @click="showDiscount = true">
				<text class="input-label">专享折扣：</text>
				<text class="input-value" v-if="discountVal != ''">{{ discountVal }} 折</text>
				<text class="input-placeholder" v-else>点击选择或输入折扣数值</text>
			</view>
			<ste-custom-keyboard
				type="discount"
				v-model="discountVal"
				v-model:show="showDiscount"
				:discounts="[70, 75, 80, 85, 90, 95]"
				confirm-text="确定折扣"
				@click-discount="onDiscountClick"
			/>
		</view>

		<!-- 示例 4：文档流内嵌与安全防窥模式 -->
		<view class="demo-card">
			<text class="card-title">文档流嵌入与安全防窥</text>
			<text class="card-desc">常驻嵌入页面流 (mode="page")，开启 randomKeys 随机打乱按键防偷窥</text>
			<view class="safe-display">
				<text class="safe-display-label">当前安全输入：</text>
				<text class="safe-display-val">{{ safeVal != '' ? safeVal : '（等待输入）' }}</text>
			</view>
			<view class="keyboard-page-box">
				<ste-custom-keyboard
					mode="page"
					v-model="safeVal"
					:random-keys="true"
					:right-keys="true"
					confirm-text="提交"
					@confirm="onSafeConfirm"
				/>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
/**
 * @file custom-keyboard.uvue
 * @description CustomKeyboard 定制键盘组件 Demo 演示页面
 */

import { ref } from 'vue';

// ==================== 示例 1 数据 ====================
const numberVal = ref('');
const showNumber = ref(false);

function onNumberConfirm(val: string) {
	uni.showToast({
		title: '发起支付: ¥' + val,
		icon: 'none'
	});
}

// ==================== 示例 2 数据 ====================
const idCardVal = ref('');
const showIdCard = ref(false);

function onIdCardConfirm(val: string) {
	uni.showToast({
		title: '身份证录入完成: ' + val,
		icon: 'none'
	});
}

// ==================== 示例 3 数据 ====================
const discountVal = ref('8.5');
const showDiscount = ref(false);

function onDiscountClick(text: string) {
	uni.showToast({
		title: '快捷选择: ' + text,
		icon: 'none'
	});
}

// ==================== 示例 4 数据 ====================
const safeVal = ref('');

function onSafeConfirm(val: string) {
	uni.showToast({
		title: '安全确认提交: ' + val,
		icon: 'none'
	});
}
</script>

<style>
