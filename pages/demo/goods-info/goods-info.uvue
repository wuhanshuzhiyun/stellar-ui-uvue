<template>
	<scroll-view scroll-y="true" class="page-root">
		<!-- 顶部导航标题区 -->
		<view class="demo-header">
			<text class="demo-title">GoodsInfo 商品信息</text>
			<text class="demo-subtitle">用于展示商品图文、价格、标签、编码、条码、复选框、步进器与建议用量面板，支持门店与食堂两种排版模式</text>
		</view>

		<!-- 示例 1：基础用法 -->
		<view class="demo-card">
			<text class="card-title">1. 基础商品信息</text>
			<text class="card-desc">展示商品主图、新品标签、商品编码、条码、现价与划线参考价</text>
			<view class="card-content">
				<ste-goods-info
					:data="basicGoods"
					:imageSize="140"
					@click="onGoodsClick"
				/>
			</view>
		</view>

		<!-- 示例 2：选择框模式 -->
		<view class="demo-card">
			<text class="card-title">2. 选择框模式 (左右位置与事件监听)</text>
			<text class="card-desc">支持左侧复选框与右侧复选框排版，支持 v-model:checked 双向绑定</text>
			<view class="card-content gap-vertical">
				<!-- 左侧选择框 -->
				<ste-goods-info
					checkbox="left"
					v-model:checked="leftChecked"
					:data="checkedGoodsLeft"
					:imageSize="140"
					@change="onGoodsChange"
				/>
				<!-- 右侧选择框 -->
				<ste-goods-info
					class="margin-top-box"
					checkbox="right"
					v-model:checked="rightChecked"
					:data="checkedGoodsRight"
					:imageSize="140"
					@change="onGoodsChange"
				/>
			</view>
		</view>

		<!-- 示例 3：数量步进器与增减拦截 -->
		<view class="demo-card">
			<text class="card-title">3. 数量步进器 (支持弹窗确认拦截)</text>
			<text class="card-desc">开启 stepper，增加减少时支持异步弹窗确认（next / stop）</text>
			<view class="card-content">
				<ste-goods-info
					checkbox="right"
					:data="stepperGoods"
					:imageSize="140"
					:stepper="true"
					v-model:number="goodsNumber"
					:min="1"
					:max="99"
					@change="onGoodsChange"
					@plus="onStepperPlus"
					@minus="onStepperMinus"
				/>
			</view>
		</view>

		<!-- 示例 4：插槽定制 (副标题插槽与操作插槽) -->
		<view class="demo-card">
			<text class="card-title">4. 自定义插槽定制</text>
			<text class="card-desc">使用默认插槽定制副标题业务信息，使用 stepper 插槽自定义右侧操作按钮</text>
			<view class="card-content">
				<ste-goods-info
					:data="slotGoods"
					:imageSize="140"
				>
					<!-- 默认插槽：自定义副标题促销标签 -->
					<view class="custom-slot-box">
						<text class="custom-tag">限时特惠</text>
						<text class="custom-desc">顺丰冷链包邮 · 坏单包赔</text>
					</view>
					<!-- stepper 插槽：自定义右侧抢购按钮 -->
					<template #stepper>
						<ste-button
							:mode="100"
							:rootStyle="{ height: '48rpx' }"
							type="primary"
							background="#ea4335"
							color="#ffffff"
							@click="onBuyClick"
						>
							<text class="buy-btn-text">立即抢购</text>
						</ste-button>
					</template>
				</ste-goods-info>
			</view>
		</view>

		<!-- 示例 5：建议用量与撤销历史 -->
		<view class="demo-card">
			<text class="card-title">5. 建议用量面板与申请撤销</text>
			<text class="card-desc">点击“建议”展开明细条目，支持申请输入与撤销返回历史数值</text>
			<view class="card-content">
				<ste-goods-info
					:data="suggestGoods"
					:imageSize="140"
					:suggestData="suggestConfig"
					@click-suggest="onSuggestClick"
				/>
			</view>
		</view>

		<!-- 示例 6：食堂精简模式 -->
		<view class="demo-card">
			<text class="card-title">6. 食堂精简模式 (mode='less')</text>
			<text class="card-desc">竖向大图展示，隐藏条形码与建议面板，突出大图、菜品描述与价格</text>
			<view class="card-content">
				<ste-goods-info
					mode="less"
					:data="canteenGoods"
				>
					<template #stepper>
						<view class="canteen-badge">
							<text class="canteen-badge-text">今日主推</text>
						</view>
					</template>
				</ste-goods-info>
			</view>
		</view>

		<!-- 示例 7：状态水印 -->
		<view class="demo-card">
			<text class="card-title">7. 业务状态水印</text>
			<text class="card-desc">在卡片右下角展示业务印章（如已打印、已盘点、已审核等）</text>
			<view class="card-content">
				<ste-goods-info
					:data="watermarkGoods"
					:imageSize="140"
					watermark="https://image.whzb.com/chain/StellarUI/已打印.png"
				/>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
/**
 * @file goods-info.uvue
 * @description ste-goods-info 商品信息 原生演示页面
 */
import {
	GoodsInfoType,
	SuggestData,
	SuggestDataItem,
	GoodsInfoChangePayload
} from '@/uni_modules/stellar-ui-uvue/components/ste-goods-info/constants.uts';

/** 示例 1：基础商品 */
const basicGoods = ref<GoodsInfoType>({
	image: 'https://image.whzb.com/chain/StellarUI/image/img1.jpg',
	title: '云南高山高甜小粒蓝莓 125g 现摘鲜果',
	subTitle: '原产地直发，果径 18mm+，饱满多汁，自然果粉',
	tag: '新品上市',
	code: 'SP-883012',
	barCode: '6901234567890',
	price: '2990',
	originalPrice: '3990'
} as GoodsInfoType);

/** 示例 2：复选框联动 */
const leftChecked = ref<boolean>(true);
const rightChecked = ref<boolean>(false);

const checkedGoodsLeft = ref<GoodsInfoType>({
	image: 'https://image.whzb.com/chain/StellarUI/image/img2.jfif',
	title: '新西兰进口纯牛奶 250ml*12盒 礼盒装',
	subTitle: '每 100ml 含有 3.8g 优质原生乳蛋白',
	tag: '热卖特惠',
	code: 'SP-661021',
	barCode: '6933321100912',
	price: '5990',
	originalPrice: '7990'
} as GoodsInfoType);

const checkedGoodsRight = ref<GoodsInfoType>({
	image: 'https://image.whzb.com/chain/StellarUI/image/img3.jpg',
	title: '手作烘焙全麦坚果欧包 85g 早餐轻食',
	subTitle: '无蔗糖添加，富含膳食纤维与核桃仁',
	tag: '低脂轻卡',
	code: 'SP-550918',
	barCode: '6988771122334',
	price: '1680',
	originalPrice: '2200'
} as GoodsInfoType);

/** 示例 3：步进器 */
const goodsNumber = ref<number>(2);
const stepperGoods = ref<GoodsInfoType>({
	image: 'https://image.whzb.com/chain/StellarUI/image/img4.jpg',
	title: '冷萃深烘意式浓缩咖啡豆 500g 精品豆',
	subTitle: '黑巧风味，油脂醇厚丰富，配气阀保鲜',
	tag: '人气榜首',
	code: 'SP-331008',
	barCode: '6911223344556',
	price: '6800',
	originalPrice: '8800'
} as GoodsInfoType);

/** 示例 4：插槽定制 */
const slotGoods = ref<GoodsInfoType>({
	image: 'https://image.whzb.com/chain/StellarUI/image/banner1.png',
	title: '海南当季金煌芒 5斤精选装',
	tag: '爆款推荐',
	code: 'SP-992015',
	barCode: '6955443322110',
	price: '3990',
	originalPrice: '5800'
} as GoodsInfoType);

/** 示例 5：建议用量 */
const suggestGoods = ref<GoodsInfoType>({
	image: 'https://image.whzb.com/chain/StellarUI/image/banner2.png',
	title: '有机鲜榨初榨橄榄油 750ml 物理压榨',
	subTitle: '原装特级初榨，酸度≤0.5%，烹饪沙拉好伴侣',
	tag: '采购建议',
	code: 'SP-100223',
	barCode: '6909876543210',
	price: '12800',
	originalPrice: '16800'
} as GoodsInfoType);

const suggestConfig = ref<SuggestData>({
	title: '智能建议',
	number: 12,
	applyForText: '申请用量',
	applyForNumber: 8,
	items: [
		{ label: '周均消耗', value: 15 } as SuggestDataItem,
		{ label: '在途数量', value: 4 } as SuggestDataItem,
		{ label: '安全库存', value: 20 } as SuggestDataItem
	]
} as SuggestData);

/** 示例 6：食堂精简模式 */
const canteenGoods = ref<GoodsInfoType>({
	image: 'https://image.whzb.com/chain/StellarUI/image/img1.jpg',
	title: '广式蜜汁叉烧饭套餐 (配例汤+时蔬)',
	subTitle: '选用上等梅头肉，秘制酱汁慢火烤制，肉质鲜嫩多汁，搭配五常大米与养生炖汤。',
	tag: '厨师精选',
	price: '2800',
	originalPrice: '3500'
} as GoodsInfoType);

/** 示例 7：水印商品 */
const watermarkGoods = ref<GoodsInfoType>({
	image: 'https://image.whzb.com/chain/StellarUI/image/img2.jfif',
	title: '法式香草大西洋三文鱼排 200g 急冻锁鲜',
	subTitle: 'BAP四星认证，原切去刺，富含Omega-3',
	tag: '已验入库',
	code: 'SP-776655',
	barCode: '6977889900112',
	price: '4800',
	originalPrice: '6200'
} as GoodsInfoType);

/** 通用点击回调 */
function onGoodsClick(type : string) {
	uni.showToast({
		title: `点击了[${type}]区域`,
		icon: 'none'
	});
}

/** 数据变更回调 */
function onGoodsChange(change : GoodsInfoChangePayload, data : GoodsInfoType) {
	if (change.checked != null) {
		uni.showToast({
			title: `选中状态: ${change.checked}`,
			icon: 'none'
		});
	} else if (change.number != null) {
		uni.showToast({
			title: `数量更新为: ${change.number}`,
			icon: 'none'
		});
	}
}

/** 步进器增加拦截 */
function onStepperPlus(_v : any, suspend : () => void, next : () => void, stop : () => void) {
	suspend();
	uni.showModal({
		title: '数量增加确认',
		content: '确定要将购买数量增加 1 份吗？',
		success: (res) => {
			if (res.confirm) {
				next();
			} else {
				stop();
			}
		}
	});
}

/** 步进器减少拦截 */
function onStepperMinus(_v : any, suspend : () => void, next : () => void, stop : () => void) {
	suspend();
	uni.showModal({
		title: '数量减少确认',
		content: '确定要减少 1 份吗？',
		success: (res) => {
			if (res.confirm) {
				next();
			} else {
				stop();
			}
		}
	});
}

/** 自定义购买按钮点击 */
function onBuyClick() {
	uni.showToast({
		title: '已加入待支付清单！',
		icon: 'success'
	});
}

/** 建议面板点击 */
function onSuggestClick(type : string, item ?: SuggestDataItem) {
	if (type == 'method') {
		uni.showToast({
			title: '切换明细面板折叠状态',
			icon: 'none'
		});
	} else if (type == 'back') {
		uni.showToast({
			title: '已撤销并恢复上一次输入',
			icon: 'none'
		});
	} else if (type == 'item' && item != null) {
		uni.showToast({
			title: `查看[${item.label}]: ${item.value}`,
			icon: 'none'
		});
	}
}
</script>

<style scoped>
.page-root {
	width: 100%;
	height: 100%;
	background-color: #f7f8fa;
}

.demo-header {
	padding: 36rpx 32rpx 20rpx;
}

.demo-title {
	font-size: 38rpx;
	font-weight: bold;
	color: #1f2329;
}

.demo-subtitle {
	font-size: 24rpx;
	color: #8f959e;
	margin-top: 12rpx;
	line-height: 36rpx;
}

.demo-card {
	margin: 20rpx 24rpx;
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 24rpx;
}

.card-title {
	font-size: 28rpx;
	font-weight: bold;
	color: #1f2329;
}

.card-desc {
	font-size: 22rpx;
	color: #8f959e;
	margin-top: 8rpx;
	margin-bottom: 20rpx;
	line-height: 32rpx;
}

.card-content {
	background-color: #fcfdfe;
	border-radius: 12rpx;
	border: 1rpx solid #edf0f5;
	overflow: hidden;
}

.gap-vertical {
	padding: 8rpx;
}

.margin-top-box {
	margin-top: 16rpx;
}

/* 自定义插槽样式 */
.custom-slot-box {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 10rpx;
}

.custom-tag {
	font-size: 20rpx;
	color: #ea4335;
	background-color: #fde8e8;
	padding: 2rpx 8rpx;
	border-radius: 4rpx;
	margin-right: 12rpx;
}

.custom-desc {
	font-size: 22rpx;
	color: #8f959e;
}

.buy-btn-text {
	font-size: 22rpx;
	color: #ffffff;
	font-weight: 500;
}

.canteen-badge {
	padding: 6rpx 14rpx;
	background-color: #e8f3ff;
	border-radius: 20rpx;
}

.canteen-badge-text {
	font-size: 22rpx;
	color: #0275ff;
	font-weight: 500;
}
</style>
