<template>
	<!--
		ScrollTo 滚动锚点演示页面
		规范要求：顶级容器 scroll-view 必须设置 flex: 1 以保障页面手势滚动顺畅响应
	-->
	<scroll-view direction="vertical" class="page">
		<!-- 页面顶部标题与功能简介 -->
		<view class="header">
			<text class="title">ScrollTo 滚动锚点</text>
			<text class="desc">支持通过下标快速跳转到指定锚点区域，同时支持在滚动时自动反向识别高亮对应导航项。</text>
		</view>

		<!-- 控制与状态卡片 -->
		<view class="control-card">
			<view class="control-row">
				<text class="control-label">快捷跳转：</text>
				<view class="btn-group">
					<button
						v-for="(tab, index) in tabList"
						:key="index"
						class="mini-btn"
						size="mini"
						@click="jumpTo(index)"
					>
						{{ tab }}
					</button>
				</view>
			</view>
			<view class="status-row">
				<text class="status-tip">当前高亮下标：{{ currentActive }}</text>
				<text class="status-tip">最近触发事件：{{ lastEventInfo }}</text>
			</view>
		</view>

		<!-- 演示场景容器 -->
		<view class="demo-wrapper">
			<!-- 顶部模拟 Tab 导航栏 -->
			<view class="tab-nav-bar">
				<view
					v-for="(tab, index) in tabList"
					:key="index"
					:class="['tab-nav-item', currentActive == index ? 'tab-nav-item-active' : '']"
					@click="jumpTo(index)"
				>
					<text :class="['tab-nav-text', currentActive == index ? 'tab-nav-text-active' : '']">{{ tab }}</text>
				</view>
			</view>

			<!-- 滚动锚点组件主体（设置固定高度以展示内部联动） -->
			<view class="scroll-container">
				<ste-scroll-to
					v-model:active="currentActive"
					height="750rpx"
					@change="handleActiveChange"
				>
					<ste-scroll-to-item
						v-for="(item, index) in sectionList"
						:key="index"
					>
						<view class="section-card" :style="{ backgroundColor: item.bg }">
							<view class="section-header">
								<text class="section-badge">#{{ index + 1 }}</text>
								<text class="section-title">{{ item.title }}</text>
							</view>
							<text class="section-desc">{{ item.content }}</text>
							<view class="section-items">
								<view
									v-for="(tag, tagIdx) in item.tags"
									:key="tagIdx"
									class="tag-chip"
								>
									<text class="tag-chip-text">{{ tag }}</text>
								</view>
							</view>
						</view>
					</ste-scroll-to-item>
				</ste-scroll-to>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'

	/** 区域项数据结构 */
	type SectionItem = {
		title : string
		content : string
		bg : string
		tags : Array<string>
	}

	/** 当前激活的子项下标 */
	const currentActive = ref(0)

	/** 事件派发日志信息 */
	const lastEventInfo = ref('无')

	/** 导航 Tab 列表 */
	const tabList = ref<Array<string>>(['商品概览', '核心特性', '技术规格', '用户评价', '常见疑问'])

	/** 各锚点具体内容列表 */
	const sectionList = ref<Array<SectionItem>>([
		{
			title: '商品概览',
			content: '本商品采用跨平台原生全向渲染架构，完美适配各终端视口尺寸与高刷手势交互体验。内置丰富的双向通信与状态响应机制。',
			bg: '#f6ffed',
			tags: ['全平台适配', '纯 UTS 实现', '零运行时负担']
		},
		{
			title: '核心特性',
			content: '1. 双向自动联动：支持主动设置下标滚动，以及手势滑动反向计算激活位置。\n2. 智能防抖防抖锁：内置平滑滚动锁定，彻底规避回环震荡死循环。\n3. 轻量化声明式 API：仅需两层语义化标签即可完成任意复杂结构构建。',
			bg: '#e6f7ff',
			tags: ['双向联动', '防环路抖动', '丝滑高刷']
		},
		{
			title: '技术规格',
			content: '支持环境：uni-app x (Android / iOS / Web)\n样式隔离：独立 scoped 作用域\n渲染模式：原生高性能布局引擎\n插槽扩展：支持任意自定义内容嵌套。',
			bg: '#fff7e6',
			tags: ['UTS 规范', 'flex: 1 支撑', '无依赖包']
		},
		{
			title: '用户评价',
			content: '“滚动定位非常准确，尤其在安卓高刷机型上完全不掉帧，代码结构非常清晰明了！” —— 资深架构师\n“非常适合做商品详情页的楼层锚点导航。” —— 前端开发工程师',
			bg: '#fcffe6',
			tags: ['5.0满分好评', '开发者推荐', '性能强悍']
		},
		{
			title: '常见疑问',
			content: 'Q: 高度如何设定？\nA: 支持在 ste-scroll-to 上传入数字（自动转换为 px）或者 rpx、% 等样式字符串。\nQ: 如何手动触发重新测量？\nA: 组件实例对外暴露了 init() 方法，在异步加载新内容后可随时调用。',
			bg: '#f9f0ff',
			tags: ['FAQ 问答', '极简接入', '完善文档']
		}
	])

	/**
	 * 点击快捷按钮或 Tab 进行定位跳转
	 * @param index 目标下标
	 */
	function jumpTo(index : number) {
		currentActive.value = index
		lastEventInfo.value = `点击跳转到下标 ${index}`
	}

	/**
	 * 滚动时触发的激活项变化回调
	 * @param index 激活的目标下标
	 */
	function handleActiveChange(index : number) {
		lastEventInfo.value = `@change: 当前聚焦第 ${index + 1} 楼层`
	}
</script>

<style>
	/* 遵循全局规范：顶级 scroll-view 必须 flex: 1 */
	.page {
		flex: 1;
		background-color: #f5f6f8;
		padding: 24rpx;
	}

	.header {
		margin-bottom: 24rpx;
	}

	.title {
		font-size: 38rpx;
		font-weight: bold;
		color: #1f1f1f;
		margin-bottom: 8rpx;
	}

	.desc {
		font-size: 26rpx;
		color: #8c8c8c;
		line-height: 38rpx;
	}

	.control-card {
		background-color: #ffffff;
		border-radius: 16rpx;
		padding: 20rpx;
		margin-bottom: 24rpx;
	}

	.control-row {
		flex-direction: row;
		align-items: center;
		margin-bottom: 16rpx;
	}

