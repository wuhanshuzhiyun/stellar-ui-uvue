		font-size: 22rpx;
	}

	.status-row {
		border-top: 1px solid #f0f0f0;
		padding-top: 12rpx;
	}

	.status-tip {
		font-size: 24rpx;
		color: #1890ff;
		margin-bottom: 6rpx;
	}

	.demo-wrapper {
		background-color: #ffffff;
		border-radius: 16rpx;
		overflow: hidden;
	}

	.tab-nav-bar {
		flex-direction: row;
		border-bottom: 1px solid #eeeeee;
		background-color: #ffffff;
	}

	.tab-nav-item {
		flex: 1;
		align-items: center;
		padding: 24rpx 0;
		border-bottom: 2px solid transparent;
	}

	.tab-nav-item-active {
		border-bottom: 2px solid #1890ff;
	}

	.tab-nav-text {
		font-size: 26rpx;
		color: #666666;
	}

	.tab-nav-text-active {
		color: #1890ff;
		font-weight: bold;
	}

	.scroll-container {
		width: 100%;
		background-color: #fafafa;
	}

	.section-card {
		margin: 16rpx;
		padding: 30rpx 24rpx;
		border-radius: 16rpx;
		border: 1px solid #f0f0f0;
	}

	.section-header {
		flex-direction: row;
		align-items: center;
		margin-bottom: 14rpx;
	}

	.section-badge {
		font-size: 22rpx;
		color: #ffffff;
		background-color: #1890ff;
		padding: 2rpx 10rpx;
		border-radius: 6rpx;
		margin-right: 12rpx;
	}

	.section-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #262626;
	}

	.section-desc {
		font-size: 26rpx;
		color: #595959;
		line-height: 38rpx;
		margin-bottom: 16rpx;
	}

	.section-items {
		flex-direction: row;
		flex-wrap: wrap;
	}

	.tag-chip {
		background-color: rgba(24, 144, 255, 0.08);
		border-radius: 8rpx;
		padding: 6rpx 14rpx;
		margin-right: 12rpx;
		margin-bottom: 8rpx;
	}

	.tag-chip-text {
		font-size: 22rpx;
		color: #1890ff;
	}
