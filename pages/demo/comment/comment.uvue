<template>
	<scroll-view scroll-y="true" class="page-root">
		<!-- 顶部导航标题区 -->
		<view class="demo-header">
			<text class="demo-title">Comment 评论</text>
			<text class="demo-subtitle">商品详情评价列表，支持好评徽标、晒图九宫格与空状态首评渐变提示</text>
		</view>

		<!-- 示例 1：基础图文评价（带标签与九宫格晒图） -->
		<view class="demo-card">
			<text class="card-title">基础图文评价</text>
			<text class="card-desc">包含满意度聚合标签、好评徽章、文字正文与九宫格晒图</text>
			<view class="comment-wrapper">
				<ste-comment
					:comments="commentList1"
					:tags="tagList1"
					:total="128"
					@click-head-right="onHeadRightClick"
					@click-tag="onTagClick"
					@click-image="onImageClick"
					@click-item="onItemClick"
				></ste-comment>
			</view>
		</view>

		<!-- 示例 2：暂无评价空状态（期待首评） -->
		<view class="demo-card">
			<text class="card-title">空评价状态</text>
			<text class="card-desc">当商品尚无评价时，呈现浅橙渐变底色与“期待你的首评”占位</text>
			<view class="comment-wrapper">
				<ste-comment
					:comments="commentListEmpty"
					:tags="tagListEmpty"
					:total="0"
					@click-head-right="onHeadRightClick"
				></ste-comment>
			</view>
		</view>

		<!-- 示例 3：纯文本紧凑评价 -->
		<view class="demo-card">
			<text class="card-title">纯文本简版评价</text>
			<text class="card-desc">无标签与配图时的简洁评价排版</text>
			<view class="comment-wrapper">
				<ste-comment
					:comments="commentListSimple"
					:tags="tagListEmpty"
					:total="6"
					@click-head-right="onHeadRightClick"
					@click-item="onItemClick"
				></ste-comment>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
/**
 * @file comment.uvue
 * @description Comment 评论组件 Demo 演示页面
 */

import { ref } from 'vue';
import type { CommentType } from '@/uni_modules/stellar-ui-uvue/components/ste-comment/constants.uts';

// ==================== 事件交互回调 ====================
function onHeadRightClick(text: string) {
	uni.showToast({
		title: '点击右上角: ' + text,
		icon: 'none'
	});
}

function onTagClick(tag: string, index: number) {
	uni.showToast({
		title: '点击标签: ' + tag,
		icon: 'none'
	});
}

function onImageClick(currentUrl: string, index: number, images: string[]) {
	console.log('点击配图:', currentUrl, '索引:', index, '共' + images.length + '张');
}

function onItemClick(item: CommentType, index: number) {
	uni.showToast({
		title: '查看 ' + item.userName + ' 的评价',
		icon: 'none'
	});
}

// ==================== 示例 1 数据 (完整图文) ====================
const tagList1 = ref<string[]>([
	'牛肉很新鲜 42',
	'口感绝佳 38',
	'分量十足 26',
	'包装严实 19'
]);

const commentList1 = ref<CommentType[]>([
	{
		evaluateText: '牛肉色泽红润非常新鲜，厚切牛排煎出来香嫩多汁，物流顺丰冷链干冰保鲜很到位，全家人都赞不绝口！',
		date: '2024.10.12',
		type: 1,
		userName: '星河极客',
		userAvatar: 'https://image.whzb.com/chain/StellarUI/图片.jpg',
		imgList: [
			'https://image.whzb.com/chain/StellarUI/image/comment_1.png',
			'https://image.whzb.com/chain/StellarUI/image/comment_2.png',
			'https://image.whzb.com/chain/StellarUI/image/comment_3.png',
			'https://image.whzb.com/chain/StellarUI/image/comment_4.png'
		]
	} as CommentType,
	{
		evaluateText: '肉质紧实纹理清晰，按照店家推荐的方法煎制五分熟口感极佳，回购很多次了。',
		date: '2024.10.08',
		type: 1,
		userName: '美食鉴赏家',
		userAvatar: 'https://image.whzb.com/chain/StellarUI/图片.jpg',
		imgList: [
			'https://image.whzb.com/chain/StellarUI/image/comment_2.png',
			'https://image.whzb.com/chain/StellarUI/image/comment_3.png'
		]
	} as CommentType
]);

// ==================== 示例 2 数据 (空状态) ====================
const tagListEmpty = ref<string[]>([]);
const commentListEmpty = ref<CommentType[]>([]);

// ==================== 示例 3 数据 (纯文本简版) ====================
const commentListSimple = ref<CommentType[]>([
	{
		evaluateText: '商品包装完好，物流速度很快，性价比很高，总体满意。',
		date: '2024.10.15',
		userName: '生活探索者',
		userAvatar: 'https://image.whzb.com/chain/StellarUI/图片.jpg'
	} as CommentType
]);
</script>

