	font-size: 38rpx;
	font-weight: bold;
	color: #1f2329;
}
.desc {
	font-size: 26rpx;
	color: #646a73;
	margin-top: 10rpx;
	line-height: 38rpx;
}
.section {
	margin-bottom: 32rpx;
}
.section-title {
	font-size: 30rpx;
	font-weight: bold;
	color: #1f2329;
}
.section-desc {
	font-size: 24rpx;
	color: #8f959e;
	margin-top: 6rpx;
	margin-bottom: 14rpx;
}
.chart-card {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 16rpx;
	box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
