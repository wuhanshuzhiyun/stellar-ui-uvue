	font-size: 26rpx;
	color: #8f959e;
	margin-top: 10rpx;
	line-height: 1.5;
}

.section {
	margin-bottom: 36rpx;
}

.section-title {
	font-size: 30rpx;
	font-weight: bold;
	color: #1f2329;
	margin-bottom: 16rpx;
}

.demo-card {
	background-color: #ffffff;
	border-radius: 16rpx;
	overflow: hidden;
	box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.no-padding {
	padding: 0;
}

.cell-content {
	padding: 28rpx 32rpx;
	background-color: #ffffff;
	display: flex;
	flex-direction: column;
}

.border-bottom {
	border-bottom: 1px solid #f2f3f5;
}

.cell-title {
	font-size: 30rpx;
	font-weight: 500;
	color: #1f2329;
}

.cell-desc {
	font-size: 24rpx;
	color: #8f959e;
	margin-top: 8rpx;
}

.action-btn {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	width: 140rpx;
	height: 100%;
}

.btn-primary {
	background-color: #0090ff;
}

.btn-warning {
	background-color: #ff9900;
}

.btn-danger {
	background-color: #fa5151;
}

.btn-text {
	color: #ffffff;
	font-size: 28rpx;
	font-weight: 500;
}

.control-btn-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-start;
	padding: 20rpx 24rpx;
}

.footer-space {
	height: 80rpx;
}
</style>
