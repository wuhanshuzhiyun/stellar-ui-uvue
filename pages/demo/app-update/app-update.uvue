	margin-bottom: 16rpx;
}

.result-box {
	background-color: #f7f8fa;
	border-radius: 12rpx;
	padding: 16rpx 20rpx;
	margin-top: 16rpx;
}

.result-title {
	font-size: 24rpx;
	color: #646a73;
	font-weight: 500;
	margin-bottom: 6rpx;
}

.result-content {
	font-size: 24rpx;
	color: #1388f7;
	font-family: monospace;
}

.log-box {
	background-color: #1f2329;
