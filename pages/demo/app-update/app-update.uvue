	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 28rpx;
	margin-bottom: 24rpx;
}

.demo-item-title {
	font-size: 32rpx;
	font-weight: 600;
	color: #1f2329;
	margin-bottom: 8rpx;
}

