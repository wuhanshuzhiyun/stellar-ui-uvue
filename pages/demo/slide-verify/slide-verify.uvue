		line-height: 38rpx;
	}

	.demo-content {
		display: flex;
		flex-direction: column;
	}

	.demo-card {
		background-color: #ffffff;
		border-radius: 16rpx;
		padding: 24rpx;
		margin-bottom: 28rpx;
	}

	.card-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #333333;
		margin-bottom: 8rpx;
	}

	.card-desc {
		font-size: 24rpx;
		color: #888888;
		margin-bottom: 20rpx;
		line-height: 34rpx;
	}

	.card-inner {
		background-color: #f5f6f8;
		border-radius: 12rpx;
		padding: 24rpx 16rpx;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.mb-16 {
		margin-bottom: 16rpx;
	}

	.mb-24 {
		margin-bottom: 24rpx;
	}

	.mt-16 {
		margin-top: 16rpx;
	}

	/* 实时状态提示框 */
	.status-panel {
		background-color: #eff6ff;
		border-radius: 8rpx;
		padding: 12rpx 16rpx;
	}

	.status-panel-text {
		font-size: 24rpx;
		color: #1e40af;
		line-height: 32rpx;
	}

	/* 操作按钮栏 */
	.btn-group {
		margin-top: 16rpx;
		display: flex;
		flex-direction: row;
	}

	.btn-item {
		flex: 1;
	}

	.ctrl-btn-text {
		font-size: 28rpx;
		color: #ffffff;
	}
</style>
