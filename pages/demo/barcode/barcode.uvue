			<!-- 不显示文字 -->
			<view class="card">
				<text class="card-title">不显示文字</text>
				<text class="card-desc">设置 showText 为 false 隐藏文字</text>
				<view class="card-demo">
					<ste-barcode content="ONLYCODE" :showText="false"></ste-barcode>
				</view>
			</view>

			<!-- 自定义文字 -->
			<view class="card">
				<text class="card-title">自定义文字样式</text>
