{
    "name": "ste-steps",
    "description": "步骤条组件, 拆分展示某项流程的步骤，引导用户按流程完成任务或向用户展示当前状态。",
    "tutorial": "https://stellar-ui.intecloud.com.cn/?projectName=stellar-ui-uvue&menu=%E7%BB%84%E4%BB%B6&active=ste-steps",
    "attributes": [
        {
            "name": "active",
            "description": "当前步骤进度索引（从0开始）",
            "type": "Number",
            "default": 0
        },
        {
            "name": "direction",
            "description": "步骤条排布方向",
            "type": "String",
            "default": "row",
            "values": [
                {
                    "name": "row",
                    "description": "横向"
                },
                {
                    "name": "column",
                    "description": "竖向"
                }
            ]
        },
        {
            "name": "dot",
            "description": "是否为点状步骤条",
            "type": "Boolean",
            "default": false
        },
        {
            "name": "reverse",
            "description": "是否反转排布方向",
            "type": "Boolean",
            "default": false
        },
        {
            "name": "lineStyle",
            "description": "线条样式（solid/dashed）",
            "type": "String",
            "default": "solid"
        },
        {
            "name": "rootStyle",
            "description": "根节点自定义样式",
            "type": "Object",
            "default": {}
        },
        {
            "name": "[event]click-step",
            "description": "点击步骤标题或图标时触发",
            "params": [
                {
                    "name": "index",
                    "description": "点击的步骤序号 (1-indexed)"
                }
            ]
        },
        {
            "name": "[event]clickStep",
            "description": "点击步骤标题或图标时触发（别名）",
            "params": [
                {
                    "name": "index",
                    "description": "点击的步骤序号 (1-indexed)"
                }
            ]
        }
    ]
}