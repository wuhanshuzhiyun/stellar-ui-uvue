<template>
	<!--
		ste-swiper 轮播容器组件
		模块职责：基于官方原生 <swiper> 高性能渲染引擎二次封装，零线程通信延迟，
		提供双向绑定、水平/垂直轮播、无缝首尾循环与优雅长胶囊指示器
	-->
	<view
		:id="rootElementId"
		class="ste-swiper-root"
		:style="rootStyle"
		@touchstart="handleTouchStart"
		@touchend="handleTouchEnd"
		@touchcancel="handleTouchCancel"
	>
		<!-- 原生高性能 swiper 视口核心 -->
		<swiper
			:id="swiperElementId"
			class="ste-swiper-native"
			:style="nativeSwiperStyle"
			:current="dataCurrentIndex"
			:vertical="props.direction == 'vertical'"
			:autoplay="computedAutoplay"
			:interval="props.interval"
			:duration="props.duration"
			:circular="props.circular"
			:disable-touch="props.disabled"
			@change="handleSwiperChange"
			@animationfinish="handleAnimationFinish"
			@transition="handleTransition"
			@touchstart="handleTouchStart"
			@touchend="handleTouchEnd"
			@touchcancel="handleTouchCancel"
		>
			<slot></slot>
		</swiper>

		<!-- 自定义长胶囊指示条（横向居底，纵向居右） -->
		<view
			v-if="props.indicatorDots && registeredItems.length > 1"
			:class="['ste-swiper-dots', props.direction == 'vertical' ? 'ste-swiper-dots-vertical' : 'ste-swiper-dots-horizontal']"
		>
			<view
				v-for="(item, index) in registeredItems"
				:key="item.id"
				:class="[
					'swiper-dot-item',
					props.direction == 'vertical' ? 'swiper-dot-item-vertical' : 'swiper-dot-item-horizontal',
					dataCurrentIndex == index ? 'swiper-dot-active' : ''
				]"
				:style="getDotStyle(index)"
				@click="handleDotClick(index)"
			></view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, watch, provide, onUnmounted } from 'vue'
	import { SWIPER_KEY, SwiperContext, SwiperItemRegisterData } from './constants.uts'

	defineOptions({
		name: 'ste-swiper',
		options: {
			virtualHost: true
		}
	})

	/**
	 * 组件属性契约定义
	 */
	type SwiperProps = {
		/** 当前所在滑块的下标（支持 v-model:current 双向绑定） */
		current ?: number
		/** 滑动方向，可选值：'horizontal'（水平） | 'vertical'（垂直） */
		direction ?: string
		/** 是否禁用手势滑动 */
		disabled ?: boolean
		/** 轮播容器宽度，支持数字(px)、rpx、px 或百分比（默认 '100%'） */
		width ?: any
		/** 轮播容器高度，支持数字(px)、rpx、px 或百分比（默认 '100%'） */
		height ?: any
		/** 滑块切换动画时长，单位 ms（默认 300） */
		duration ?: number
		/** 滑动灵敏度（保留属性兼容器） */
		swipeThreshold ?: number
		/** 是否显示面板指示点（默认 false） */
		indicatorDots ?: boolean
		/** 指示点未激活颜色（默认 'rgba(255, 255, 255, 0.45)'） */
		indicatorColor ?: string
		/** 当前选中的指示点颜色（默认 '#ffffff'） */
		indicatorActiveColor ?: string
		/** 是否自动切换（默认 false） */
		autoplay ?: boolean
		/** 自动切换时间间隔，单位 ms（默认 3000） */
		interval ?: number
		/** 是否采用首尾衔接无缝循环滑动（默认 false） */
		circular ?: boolean
	}

	const props = withDefaults(defineProps<SwiperProps>(), {
		current: 0,
		direction: 'horizontal',
		disabled: false,
		width: '100%',
		height: '100%',
		duration: 300,
		swipeThreshold: 0.25,
		indicatorDots: false,
		indicatorColor: 'rgba(255, 255, 255, 0.45)',
		indicatorActiveColor: '#ffffff',
		autoplay: false,
		interval: 3000,
		circular: false
	})

	/**
	 * 事件派发契约
	 */
	const emit = defineEmits<{
		(e : 'change', index : number, source : string) : void
		(e : 'update:current', index : number) : void
		(e : 'transition', dx : number, dy : number) : void
		(e : 'animationfinish', index : number, source : string) : void
	}>()

	/** 内部当前激活滑块下标 */
	const dataCurrentIndex = ref(props.current)

	/** 已注册的子滑块项列表 */
	const registeredItems = ref<Array<SwiperItemRegisterData>>([] as Array<SwiperItemRegisterData>)

	/**
	 * 手指/手势互锁状态机设计：
	 * 1. isUserInteracting：表示用户当前是否处于触摸按住、拖拽滑动或滑块惯性减速阶段；
	 * 2. isDragging：表示手势是否已触发位移并被原生 ViewPager 拦截为滑动；
	 * 3. 业务规则：用户手指触摸期间绝对禁止自动轮播触发，松手且动画完全停稳后平滑恢复自动轮播。
	 */
	const isUserInteracting = ref(false)
	const isDragging = ref(false)

	/**
	 * 指示点点击待确认下标：
	 * 点击 dot 后会先派发一次 change(source='indicator')，原生 swiper 随后还会补发一条
	 * 同下标的 change(source='')。若不拦截，父级 @change 会被调用两次，
	 * 且第二次来源为空字符串，demo / 业务统计都会出现「来源: 」的脏数据。
	 */
	let pendingIndicatorIndex = -1

	let resumeDebounceTimer : number = 0
	let safeFallbackTimer : number = 0

	/**
	 * 清理所有防抖与安全兜底定时器
	 */
	function clearAllSafetyTimers() {
		if (resumeDebounceTimer != 0) {
			clearTimeout(resumeDebounceTimer)
			resumeDebounceTimer = 0
		}
		if (safeFallbackTimer != 0) {
			clearTimeout(safeFallbackTimer)
			safeFallbackTimer = 0
		}
	}

	/**
	 * 动态计算原生 swiper 实际绑定的 autoplay 属性
	 * 业务规则：当组件外部未开启 autoplay，或用户当前正与屏幕交互时，无条件挂起自动轮播
	 */
	const computedAutoplay = computed(() : boolean => {
		if (!props.autoplay) return false
		if (isUserInteracting.value) return false
		return true
	})

	/** 轮播根节点与原生 swiper 的唯一 DOM ID */
	// 原实现为「实例内递增序号 + Date.now()」：序号是每个实例独立的闭包变量，
	// 同一渲染帧创建的多个实例会拿到完全相同的 id。改为随机数兜底，
	// 与库内其它组件（dropdown-menu / index-list）的生成方式保持一致。
	const rootElementId = ref<string>('ste_swiper_root_' + Math.floor(Math.random() * 1000000).toString())
	const swiperElementId = ref<string>('ste_swiper_native_' + Math.floor(Math.random() * 1000000).toString())

	/**
	 * 原生 swiper 视口计算样式
	 */
	const nativeSwiperStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {}
		style['width'] = '100%'
		style['height'] = '100%'
		return style
	})

	/**
	 * 根容器计算样式
	 */
	const rootStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {}
		if (typeof props.width == 'number') {
			style['width'] = `${props.width}px`
		} else if (typeof props.width == 'string') {
			const wStr = props.width as string
			style['width'] = /^\d+$/.test(wStr) ? `${wStr}rpx` : wStr
		}

		if (typeof props.height == 'number') {
			style['height'] = `${props.height}px`
		} else if (typeof props.height == 'string') {
			const hStr = props.height as string
			style['height'] = /^\d+$/.test(hStr) ? `${hStr}rpx` : hStr
		}
		return style
	})

	/**
	 * 动态获取指示点样式
	 */
	function getDotStyle(index : number) : UTSJSONObject {
		const style : UTSJSONObject = {}
		if (index == dataCurrentIndex.value) {
			style['backgroundColor'] = props.indicatorActiveColor != '' ? props.indicatorActiveColor : '#ffffff'
		} else {
			style['backgroundColor'] = props.indicatorColor != '' ? props.indicatorColor : 'rgba(255, 255, 255, 0.45)'
		}
		return style
	}

	/**
	 * 监听手指触碰触摸开始
	 * 业务规则：用户手指一旦接触轮播区域，必须立即无条件挂起自动轮播，启动手势互动互锁
	 */
	function handleTouchStart(event : UniTouchEvent) {
		clearAllSafetyTimers()
		isUserInteracting.value = true
		isDragging.value = false
		// 用户重新上手触摸，此前指示点点击留下的待确认标记随即失效
		pendingIndicatorIndex = -1

		// 启动 8 秒安全兜底定时器，防止极端手势滑出边界导致自动轮播永久锁死
		safeFallbackTimer = setTimeout(() => {
			if (isUserInteracting.value) {
				isUserInteracting.value = false
				isDragging.value = false
			}
		}, 8000)
	}

	/**
	 * 监听手势取消（touchcancel）
	 * 业务规则：在 Android 原生端，当手指滑动超过系统阈值时，原生 ViewPager 拦截事件并向上层派发 ACTION_CANCEL，
	 * 此时用户手指处于拖拽中，标记进入原生拖拽阶段 isDragging = true。
	 */
	function handleTouchCancel(event : UniTouchEvent) {
		isDragging.value = true
	}

	/**
	 * 监听手指离开屏幕（touchend）
	 * 业务规则：
	 * 1. 若未发生拖拽滑动（单纯轻触/点击），手指抬起后经微延迟平滑释放互锁；
	 * 2. 若已发生拖拽滑动（isDragging 为 true），滑块将进入惯性滑行/回弹减速动画，
	 *    此时不能立即释放，等待最终的 animationfinish 权威静止事件释放互锁。
	 */
	function handleTouchEnd(event : UniTouchEvent) {
		if (!isDragging.value) {
			clearAllSafetyTimers()
			resumeDebounceTimer = setTimeout(() => {
				isUserInteracting.value = false
			}, 150)
		}
	}

	/**
	 * 监听原生 swiper 的 change 事件并向上冒泡
	 */
	function handleSwiperChange(event : UniSwiperChangeEvent) {
		const detail = event.detail
		const newIndex = detail.current
		// 指示点点击已派发过 change/update:current，原生补发的同下标 change 直接吞掉
		if (pendingIndicatorIndex >= 0 && newIndex == pendingIndicatorIndex) {
			pendingIndicatorIndex = -1
			return
		}
		const source = detail.source
		dataCurrentIndex.value = newIndex
		emit('change', newIndex, source)
		emit('update:current', newIndex)
	}

	/**
	 * 监听原生滑块滑动动画结束事件（权威静止信号）
	 * 业务规则：无论是手势拖拽还是回弹，滑块在目标页完全静止时必定触发此事件。
	 * 此时释放手势互动锁，并平滑恢复自动轮播，确保从新停留页开始完整的 interval 倒计时。
	 */
	function handleAnimationFinish(event : UniSwiperAnimationFinishEvent) {
		const detail = event.detail
		dataCurrentIndex.value = detail.current

		// 滑块彻底完全停稳，重置手势拖拽状态并安全解除互动互锁
		if (isUserInteracting.value) {
			clearAllSafetyTimers()
			isDragging.value = false
			resumeDebounceTimer = setTimeout(() => {
				isUserInteracting.value = false
			}, 100)
		}

		emit('animationfinish', detail.current, detail.source)
	}

	/**
	 * 监听滑动过渡中的位移事件
	 */
	function handleTransition(event : UniSwiperTransitionEvent) {
		if (isUserInteracting.value && !isDragging.value) {
			isDragging.value = true
		}
		const detail = event.detail
		emit('transition', detail.dx, detail.dy)
	}

	/**
	 * 点击指示器长胶囊切换
	 */
	function handleDotClick(index : number) {
		if (index >= 0 && index < registeredItems.value.length) {
			// 记录待确认下标，等原生 swiper 补发同下标 change 时跳过重复派发
			pendingIndicatorIndex = index
			dataCurrentIndex.value = index
			emit('change', index, 'indicator')
			emit('update:current', index)
		}
	}

	/**
	 * 监听外部 props.current 动态更新
	 */
	watch(
		() : number => props.current,
		(newVal : number) => {
			if (newVal != dataCurrentIndex.value) {
				// 外部程序化改 current，指示点点击的待确认标记随之失效
				pendingIndicatorIndex = -1
				dataCurrentIndex.value = newVal
			}
		}
	)

	/**
	 * 向子组件提供上下文通信能力
	 */
	provide<SwiperContext>(SWIPER_KEY, {
		getCurrentIndex: () : number => dataCurrentIndex.value,
		getDirection: () : string => props.direction,
		registerItem: (item : SwiperItemRegisterData) : number => {
			// 拷贝后整体回写而不是原地 push：App 端对 ref 数组的原地变更通知不可靠，
			// push 不触发更新时指示点列表会整个渲染不出来。
			// 按 id 覆盖式注册，重复注册（HMR / 父级重渲染）不会产生重复指示点。
			const list = registeredItems.value.slice()
			let existIdx = -1
			for (let i = 0; i < list.length; i++) {
				if (list[i].id == item.id) {
					existIdx = i
					break
				}
			}
			if (existIdx >= 0) {
				list[existIdx] = item
			} else {
				list.push(item)
			}
			registeredItems.value = list
			return existIdx >= 0 ? existIdx : list.length - 1
		},
		unregisterItem: (id : string) => {
			const list = registeredItems.value.slice()
			const idx = list.findIndex((it : SwiperItemRegisterData) : boolean => it.id == id)
			if (idx != -1) {
				list.splice(idx, 1)
				registeredItems.value = list
				// 注销后当前下标可能越界，回退到最后一个有效滑块
				if (list.length > 0 && dataCurrentIndex.value >= list.length) {
					dataCurrentIndex.value = list.length - 1
				}
			}
		}
	})

	/**
	 * 暴露组件公共实例方法
	 */
	defineExpose({
		/**
		 * 重新初始化组件内部状态
		 */
		init: () => {
			dataCurrentIndex.value = props.current
		}
	})

	onUnmounted(() => {
		// 手势互锁的防抖与 8s 安全兜底定时器都必须销毁，
		// 否则组件卸载后仍会回调并改写已销毁实例的状态
		clearAllSafetyTimers()
	})
</script>

<style scoped>
	.ste-swiper-root {
		position: relative;
		overflow: hidden;
	}

	.ste-swiper-native {
		width: 100%;
		height: 100%;
	}

	/* 自定义指示器整体容器 */
	.ste-swiper-dots {
		position: absolute;
		z-index: 10;
		align-items: center;
	}

	.ste-swiper-dots-horizontal {
		bottom: 18rpx;
		left: 0;
		right: 0;
		flex-direction: row;
		justify-content: center;
	}

	.ste-swiper-dots-vertical {
		right: 18rpx;
		top: 0;
		bottom: 0;
		flex-direction: column;
		justify-content: center;
	}

	/* 单个指示点：随激活状态瞬时响应，长胶囊高质感过渡 */
	.swiper-dot-item {
		border-radius: 6rpx;
	}

	.swiper-dot-item-horizontal {
		width: 10rpx;
		height: 10rpx;
		margin: 0 6rpx;
	}

	.swiper-dot-item-horizontal.swiper-dot-active {
		width: 28rpx;
	}

	.swiper-dot-item-vertical {
		width: 10rpx;
		height: 10rpx;
		margin: 6rpx 0;
	}

	.swiper-dot-item-vertical.swiper-dot-active {
		height: 28rpx;
	}
</style>
