{
    "name": "ste-table-column",
    "description": "表格列组件，配合 ste-table 使用，定义列的标题、字段属性、对齐方式与自定义插槽渲染。",
    "tutorial": "https://stellar-ui.intecloud.com.cn/?projectName=stellar-ui-uvue&menu=%E7%BB%84%E4%BB%B6&active=ste-table",
    "attributes": [
        {
            "name": "label",
            "description": "列标题显示的文本内容",
            "type": "string",
            "default": ""
        },
        {
            "name": "prop",
            "description": "对应列内容的字段名",
            "type": "string",
            "default": ""
        },
        {
            "name": "type",
            "description": "对应列的特殊展示类型",
            "type": "string",
            "values": [
                {
                    "name": "checkbox",
                    "description": "多选复选框列"
                },
                {
                    "name": "radio",
                    "description": "单选单选框列"
                },
                {
                    "name": "index",
                    "description": "自动自增行序号列"
                }
            ]
        },
        {
            "name": "width",
            "description": "对应列的宽度（支持 px/rpx）",
            "type": "string | number",
            "default": ""
        },
        {
            "name": "minWidth",
            "description": "对应列的最小宽度（支持 px/rpx）",
            "type": "string | number",
            "default": ""
        },
        {
            "name": "align",
            "description": "单元格内容对齐方式",
            "type": "string",
            "default": "left",
            "values": [
                {
                    "name": "left",
                    "description": "左对齐"
                },
                {
                    "name": "center",
                    "description": "居中对齐"
                },
                {
                    "name": "right",
                    "description": "右对齐"
                }
            ]
        },
        {
            "name": "headerAlign",
            "description": "表头标题对齐方式（缺省时同 align）",
            "type": "string",
            "default": "left",
            "values": [
                {
                    "name": "left",
                    "description": "左对齐"
                },
                {
                    "name": "center",
                    "description": "居中对齐"
                },
                {
                    "name": "right",
                    "description": "右对齐"
                }
            ]
        },
        {
            "name": "showPopover",
            "description": "文本超长时是否显示 Popover 气泡提示（优先级高于表格级别）",
            "type": "boolean"
        },
        {
            "name": "popoverLine",
            "description": "Popover 提示的触发超出行数（优先级高于表格级别）",
            "type": "number"
        },
        {
            "name": "customKey",
            "description": "自定义唯一标识 key 值",
            "type": "string",
            "default": ""
        },
        {
            "name": "[slot]default",
            "description": "作用域插槽，用于自定义当前列单元格的展示内容",
            "params": [
                {
                    "name": "row",
                    "description": "当前行数据对象"
                },
                {
                    "name": "rowIndex",
                    "description": "当前行索引下标"
                },
                {
                    "name": "column",
                    "description": "当前列定义对象"
                }
            ]
        },
        {
            "name": "[slot]empty",
            "description": "当前列单元格数据为空时的自定义展示内容插槽"
        }
    ]
}
