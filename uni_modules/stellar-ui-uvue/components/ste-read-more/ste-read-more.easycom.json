{
    "name": "ste-read-more",
    "description": "该组件用于长图文内容预先折叠收起一部分，并在底部叠加渐变遮罩，点击展开全部内容。",
    "example": "<ste-read-more :showHeight='400'><text>长文本内容...</text></ste-read-more>",
    "tutorial": "https://stellar-ui.intecloud.com.cn/?projectName=stellar-ui-uvue&menu=%E7%BB%84%E4%BB%B6&active=ste-read-more",
    "attributes": [
        {
            "name": "showHeight",
            "description": "折叠展示高度阈值",
            "type": "Number|String",
            "default": 400
        },
        {
            "name": "toggle",
            "description": "展开后是否显示收起按钮",
            "type": "Boolean",
            "default": false
        },
        {
            "name": "closeText",
            "description": "折叠状态下的展开按钮文本",
            "type": "String",
            "default": "展开阅读全文"
        },
        {
            "name": "openText",
            "description": "展开状态下的收起按钮文本",
            "type": "String",
            "default": "收起"
        },
        {
            "name": "fontSize",
            "description": "操作按钮字号大小",
            "type": "Number|String",
            "default": 28
        },
        {
            "name": "color",
            "description": "操作按钮文本与图标颜色",
            "type": "String",
            "default": "#666666"
        },
        {
            "name": "rootStyle",
            "description": "根节点自定义样式",
            "type": "Object",
            "default": {}
        },
        {
            "name": "[event]open",
            "description": "点击展开时触发"
        },
        {
            "name": "[event]close",
            "description": "点击收起时触发"
        },
        {
            "name": "[method]init",
            "description": "重新初始化组件内部高度计算过程（适用于异步获取内容渲染后重新测量）"
        },
        {
            "name": "[slot]default",
            "description": "需要被折叠/展开的主体内容插槽"
        }
    ]
}
