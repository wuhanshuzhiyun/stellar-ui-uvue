{
    "name": "ste-number-keyboard",
    "description": "用于移动端数字、验证码、金额录入等场景的虚拟键盘组件，支持弹出层模式与页面内嵌展示。",
    "example": "<ste-number-keyboard v-model='val' v-model:show='show'></ste-number-keyboard>",
    "tutorial": "https://stellar-ui.intecloud.com.cn/?projectName=stellar-ui-uvue&menu=%E7%BB%84%E4%BB%B6&active=ste-number-keyboard",
    "attributes": [
        {
            "name": "mode",
            "description": "键盘模式",
            "type": "String",
            "default": "popup",
            "values": [
                {
                    "name": "popup",
                    "description": "弹出式"
                },
                {
                    "name": "page",
                    "description": "页面式"
                }
            ]
        },
        {
            "name": "modelValue",
            "description": "输入值，支持 v-model 双向绑定",
            "type": "String",
            "default": ""
        },
        {
            "name": "maxlength",
            "description": "输入值最大长度限制",
            "type": "Number",
            "default": null
        },
        {
            "name": "show",
            "description": "是否显示键盘 (mode='popup' 时生效)",
            "type": "Boolean",
            "default": false
        },
        {
            "name": "rightKeys",
            "description": "是否显示右侧功能键 (4列模式)",
            "type": "Boolean",
            "default": true
        },
        {
            "name": "randomKeys",
            "description": "按键是否随机排列",
            "type": "Boolean",
            "default": false
        },
        {
            "name": "confirmText",
            "description": "右侧确定按钮文本",
            "type": "String",
            "default": "确定"
        },
        {
            "name": "confirmDisabled",
            "description": "确定按钮是否禁用",
            "type": "Boolean",
            "default": false
        },
        {
            "name": "customKeys",
            "description": "自定义按键列表",
            "type": "Array",
            "default": []
        },
        {
            "name": "showClear",
            "description": "是否显示清空按钮",
            "type": "Boolean",
            "default": true
        },
        {
            "name": "textColor",
            "description": "按键文字颜色",
            "type": "String",
            "default": "#000000"
        },
        {
            "name": "textSize",
            "description": "按键文字大小",
            "type": "Number|String",
            "default": 48
        },
        {
            "name": "backspaceSize",
            "description": "回退按钮图标大小",
            "type": "Number|String",
            "default": 48
        },
        {
            "name": "confirmBg",
            "description": "确定按钮背景颜色",
            "type": "String",
            "default": ""
        },
        {
            "name": "confirmColor",
            "description": "确定按钮文字颜色",
            "type": "String",
            "default": "#ffffff"
        },
        {
            "name": "keyBg",
            "description": "按键背景颜色",
            "type": "String",
            "default": "#ffffff"
        },
        {
            "name": "background",
            "description": "键盘整体背景颜色",
            "type": "String",
            "default": "#f9f9f9"
        },
        {
            "name": "activeInputRef",
            "description": "多输入框联动：当前激活输入框标识",
            "type": "String",
            "default": ""
        },
        {
            "name": "inputValues",
            "description": "多输入框联动：所有输入框值对象映射",
            "type": "Object",
            "default": {}
        },
        {
            "name": "rootStyle",
            "description": "根节点自定义样式对象",
            "type": "Object",
            "default": {}
        },
        {
            "name": "[event]change",
            "description": "输入值改变时触发",
            "params": [
                {
                    "name": "value",
                    "description": "当前输入值"
                }
            ]
        },
        {
            "name": "[event]confirm",
            "description": "确认按钮点击时触发",
            "params": [
                {
                    "name": "value",
                    "description": "当前输入值"
                }
            ]
        },
        {
            "name": "[event]clear",
            "description": "清空按钮点击时触发"
        },
        {
            "name": "[event]backspace",
            "description": "退格删除按钮点击时触发"
        },
        {
            "name": "[event]click",
            "description": "点击普通按键或自定义按键时触发",
            "params": [
                {
                    "name": "key",
                    "description": "当前点击按键"
                }
            ]
        },
        {
            "name": "[event]open",
            "description": "弹窗键盘打开时触发"
        },
        {
            "name": "[event]close",
            "description": "弹窗键盘关闭时触发"
        },
        {
            "name": "[slot]default",
            "description": "弹窗顶部标题插槽"
        },
        {
            "name": "[slot]header",
            "description": "键盘上方展示内容插槽"
        }
    ]
}
