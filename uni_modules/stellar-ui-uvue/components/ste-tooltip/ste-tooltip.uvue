<template>
	<view v-if="visible" :class="['ste-tooltip-root', (maskEnabled && maskClose) ? 'ste-tooltip-root--hit' : '']">
		<!-- 透明遮罩：点击气泡以外的任意位置关闭气泡（气泡出现后才挂载，不会吃掉触发它的那次点击） -->
		<view v-if="maskEnabled && maskClose" class="tooltip-mask" @click="hideTooltip" />

		<!-- 悬浮气泡容器 -->
		<view
			class="tooltip-box"
			:style="{
				left: tooltipLeft + 'px',
				top: tooltipTop + 'px',
				opacity: opacity,
			}"
		>
			<!-- 1. 当方位为 bottom（气泡在下方）时，箭头置于气泡卡片上方，朝上指向目标 -->
			<view v-if="placement == 'bottom'" class="arrow-wrapper">
				<view class="arrow-diamond diamond-bottom" :style="{ left: (arrowLeftPx - 4) + 'px' }" />
			</view>

			<!-- 2. 气泡文字内容卡片 -->
			<view class="tooltip-content" :style="{ maxWidth: maxWidth }">
				<text class="tooltip-text" :style="cmpTextStyle">{{ text }}</text>
			</view>

			<!-- 3. 当方位为 top（气泡在上方）时，箭头置于气泡卡片下方，朝下指向目标 -->
			<view v-if="placement == 'top'" class="arrow-wrapper">
				<view class="arrow-diamond diamond-top" :style="{ left: (arrowLeftPx - 4) + 'px' }" />
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * @file ste-tooltip.uvue
	 * @description Tooltip 文字提示组件 - uni-app x / UTS 纯原生版本
	 * 用于在目标元素旁边弹出文字气泡提示，支持智能防溢出定位与动态小三角指示。
	 */
	import { ref, computed, onMounted, onUnmounted, nextTick, getCurrentInstance, ComponentPublicInstance } from 'vue'
	import { getWindowWidth } from '../../utils/utils.uts'
	import { normalizeFontSize } from '../../config/index.uts'
	import {
		TooltipOptions,
		DEFAULT_TOOLTIP_PLACEMENT,
		DEFAULT_TOOLTIP_MAX_WIDTH,
		TOOLTIP_SCREEN_MARGIN,
		TOOLTIP_ANIM_DURATION,
	} from './constants.uts'

	/** 提示文字样式（字号与行高成对跟随全局字号设置） */
	const cmpTextStyle = computed(() : UTSJSONObject => {
		return {
			fontSize: normalizeFontSize(26),
			lineHeight: normalizeFontSize(36),
		} as UTSJSONObject
	})

	defineOptions({
		name: 'ste-tooltip',
		options: {
			virtualHost: true,
		},
	})

	type TooltipProps = {
		/** 是否启用「点击气泡外空白区域关闭气泡」；关掉后只能通过 hideTooltip() 关闭 */
		maskClose ?: boolean,
	}

	const props = withDefaults(defineProps<TooltipProps>(), {
		maskClose: true,
	})

	// 当前组件自身的公共实例，供内部 SelectorQuery 测量自身气泡尺寸
	const instance = getCurrentInstance()?.proxy as ComponentPublicInstance | null

	// ==================== 响应式状态 ====================
	/** 是否挂载渲染气泡 DOM */
	const visible = ref(false)
	/** 是否启用点击遮罩关闭（气泡淡出期间立即失效，避免误吃第二次点击） */
	const maskEnabled = ref(false)
	/** 当前展示的文本内容 */
	const text = ref('')
	/** 气泡水平绝对像素坐标 */
	const tooltipLeft = ref(0)
	/** 气泡垂直绝对像素坐标 */
	const tooltipTop = ref(0)
	/** 小三角指示箭头相对于气泡卡片左边缘的物理像素偏移（单位 px，解决 Android 端不支持百分比的问题） */
	const arrowLeftPx = ref(0)
	/** 气泡最大宽度限制 */
	const maxWidth = ref(DEFAULT_TOOLTIP_MAX_WIDTH)
	/** 气泡展示方向：'top' 或 'bottom' */
	const placement = ref(DEFAULT_TOOLTIP_PLACEMENT)
	/** 气泡透明度（0 到 1），用于淡入淡出动画过渡 */
	const opacity = ref(0)

	/** 隐藏延迟定时器 */
	let hideTimer : number | null = null
	/** 淡入兜底定时器（测量回调未触发时保证气泡仍能呈现） */
	let fadeTimer : number | null = null
	/** 自动关闭定时器（options.duration > 0 时生效，每次 show 都会重置） */
	let autoHideTimer : number | null = null
	/**
	 * 展示请求序号：每次 show/hide 自增一。
	 * SelectorQuery 是异步的，连续点击不同目标时旧一轮的回调可能晚于新一轮返回，
	 * 用序号把过期回调全部丢弃，避免「旧位置覆盖新位置」「旧回调清掉新定时器」两类串扰。
	 */
	let requestId = 0

	/** 气泡默认估算尺寸（在未测得真实尺寸前用于落位，避免气泡渲染在 (0,0)） */
	const ESTIMATED_TIP_WIDTH = 200
	const ESTIMATED_TIP_HEIGHT = 40

	/**
	 * 上一次实测到的气泡真实尺寸。
	 * 连续点击不同目标时拿它做落位估算，可以让「估算位置」几乎等于「最终位置」，
	 * 否则每次点击都会先跳到估算位置再跳回真实位置，看起来像重新打开、闪一下。
	 */
	let lastTipWidth = 0
	let lastTipHeight = 0

	// ==================== 核心定位与显示逻辑 ====================

	/**
	 * 测量气泡自身真实尺寸并校准最终坐标（居中 + 防溢出 + 箭头偏移）
	 * @param triggerTop 目标元素顶部 Y 坐标
	 * @param triggerCenter 目标元素水平中心 X 坐标
	 * @param triggerHeight 目标元素高度
	 * @param vw 窗口宽度
	 * @param margin 屏幕安全边距
	 * @param useScope 是否使用组件作用域查询（失败时自动回退为全页面查询）
	 * @param reqId 发起本次测量的请求序号，回调时与最新序号不一致则视为过期、直接丢弃
	 */
	function calibrate(triggerTop : number, triggerCenter : number, triggerHeight : number, vw : number, margin : number, useScope : boolean, reqId : number) {
		let selfQuery = uni.createSelectorQuery()
		if (useScope && instance != null) {
			selfQuery = selfQuery.in(instance!)
		}
		selfQuery.select('.tooltip-content').boundingClientRect((selfRes) => {
			// 过期回调必须直接丢弃：否则上一轮的结果会覆盖新一轮的位置，
			// 甚至清掉新一轮的兜底定时器，导致 opacity 永远停在 0（气泡彻底消失）。
			if (reqId != requestId) return
			if (selfRes == null) {
				// virtualHost 组件的作用域查询可能拿不到内部节点，回退为全页面查询
				if (useScope) {
					calibrate(triggerTop, triggerCenter, triggerHeight, vw, margin, false, reqId)
				}
				return
			}
			const selfRect = selfRes as NodeInfo
			const tipWidth = selfRect.width ?? 0
			const tipHeight = selfRect.height ?? 0
			if (tipWidth <= 0 || tipHeight <= 0) return
			// 记住真实尺寸，供下一次点击的落位估算使用
			lastTipWidth = tipWidth
			lastTipHeight = tipHeight

			// 水平坐标防溢出计算（居中对齐目标元素并做屏幕左右安全边距限制）
			let left = triggerCenter - tipWidth / 2
			if (left < margin) {
				left = margin
			}
			if (left + tipWidth > vw - margin) {
				left = vw - tipWidth - margin
			}

			// 垂直坐标计算（上方或下方偏移）
			let top = 0
			if (placement.value == 'top') {
				top = triggerTop - tipHeight - 12
			} else {
				top = triggerTop + triggerHeight + 12
			}
			// 顶部空间不足时自动翻转到下方，避免气泡跑到屏幕外
			if (placement.value == 'top' && top < margin) {
				top = triggerTop + triggerHeight + 12
				placement.value = 'bottom'
			}

			// 小三角箭头物理像素位置计算（对齐目标元素中心，且不超出气泡圆角安全区）
			let targetArrowX = triggerCenter - left
			if (targetArrowX < 16) {
				targetArrowX = 16
			}
			if (targetArrowX > tipWidth - 16) {
				targetArrowX = tipWidth - 16
			}

			tooltipLeft.value = Math.round(left)
			tooltipTop.value = Math.round(top)
			arrowLeftPx.value = Math.round(targetArrowX)

			// 测量已完成，撤销兜底定时器并确保呈现
			if (fadeTimer != null) {
				clearTimeout(fadeTimer!)
				fadeTimer = null
			}
			opacity.value = 1
		}).exec()
	}

	/**
	 * 测量目标元素并展示气泡
	 * @param selector 目标元素选择器
	 * @param context 查询作用域（组件实例），为空则查询整个页面
	 * @param allowFallback 作用域查询失败时是否回退为全页面查询
	 * @param reqId 本次展示的请求序号
	 */
	function queryTarget(selector : string, context : ComponentPublicInstance | null, allowFallback : boolean, reqId : number) {
		let targetQuery = uni.createSelectorQuery()
		if (context != null) {
			targetQuery = targetQuery.in(context)
		}

		targetQuery.select(selector).boundingClientRect((res) => {
			if (reqId != requestId) return
			if (res == null) {
				// 作用域查询不到（实例上下文无效或节点在更外层）时，回退为全页面查询
				if (context != null && allowFallback) {
					queryTarget(selector, null, false, reqId)
				} else {
					console.warn(`[ste-tooltip] 未找到选择器为 "${selector}" 的目标元素`)
				}
				return
			}
			const targetRect = res as NodeInfo
			const triggerTop = targetRect.top ?? 0
			const triggerLeft = targetRect.left ?? 0
			const triggerWidth = targetRect.width ?? 0
			const triggerHeight = targetRect.height ?? 0
			const triggerCenter = triggerLeft + triggerWidth / 2
			// 兜底：窗口宽度拿不到（返回 0）时按 375 处理，否则右侧防溢出会算出负坐标把气泡推到屏幕外
			const winW = getWindowWidth()
			const vw = winW > 0 ? winW : 375
			const margin = TOOLTIP_SCREEN_MARGIN

			// 第一步：先落位，让气泡「立刻」出现在目标附近并进入可见态。
			// 不能把呈现完全依赖后续测量回调——原生端作用域查询有可能不回调，那时 opacity 会永远停在 0。
			// 落位尺寸优先用上一次实测值：重复点同一个按钮时估算位置≈最终位置，不会再出现「先跳过去再跳回来」的闪动。
			const estW = lastTipWidth > 0 ? lastTipWidth : ESTIMATED_TIP_WIDTH
			const estH = lastTipHeight > 0 ? lastTipHeight : ESTIMATED_TIP_HEIGHT
			let estLeft = triggerCenter - estW / 2
			if (estLeft < margin) {
				estLeft = margin
			}
			if (estLeft + estW > vw - margin) {
				estLeft = vw - estW - margin
			}
			tooltipLeft.value = Math.round(estLeft)
			tooltipTop.value = Math.round(
				placement.value == 'top'
					? triggerTop - estH - 12
					: triggerTop + triggerHeight + 12
			)
			arrowLeftPx.value = Math.round(triggerCenter - estLeft)

			// 关键分支：气泡已处于显示态时（连续点击不同目标）直接换内容换位置，
			// 绝不能再把 opacity 归零——那会让带 transition 的气泡先淡出再淡入，视觉上就是闪一下甚至消失。
			const wasVisible = visible.value
			visible.value = true
			if (wasVisible) {
				opacity.value = 1
			} else {
				opacity.value = 0
				// 兜底淡入：即使下面的测量回调始终不触发，也必须把气泡显示出来
				fadeTimer = setTimeout(() => {
					opacity.value = 1
					fadeTimer = null
				}, 16)
			}
			// 遮罩在本次点击事件派发结束之后才参与命中测试，不会误吃当前这次点击
			maskEnabled.value = true

			// 第二步：下一帧测量气泡真实尺寸，用精确值校准居中位置与箭头偏移
			nextTick(() => {
				calibrate(triggerTop, triggerCenter, triggerHeight, vw, margin, true, reqId)
			})
		}).exec()
	}

	/**
	 * 关闭并隐藏文字提示
	 */
	function hideTooltip() {
		// 序号自增：让尚未返回的测量回调失效，否则关闭后旧回调可能又把气泡显示出来
		requestId = requestId + 1
		// 关闭时作废自动关闭计时
		if (autoHideTimer != null) {
			clearTimeout(autoHideTimer!)
			autoHideTimer = null
		}
		// 遮罩立即失效：淡出的 200ms 里遮罩若还在，会把用户紧接着的那次点击吃掉
		maskEnabled.value = false
		// 渐隐淡出
		opacity.value = 0
		if (fadeTimer != null) {
			clearTimeout(fadeTimer!)
			fadeTimer = null
		}
		if (hideTimer != null) {
			clearTimeout(hideTimer!)
			hideTimer = null
		}
		hideTimer = setTimeout(() => {
			visible.value = false
			hideTimer = null
		}, TOOLTIP_ANIM_DURATION)
	}

	/**
	 * 显示文字提示气泡
	 * @param options Tooltip 配置选项
	 */
	function showTooltip(options : TooltipOptions) {
		// 清理正在等待的隐藏/淡入/自动关闭定时器
		if (hideTimer != null) {
			clearTimeout(hideTimer!)
			hideTimer = null
		}
		if (fadeTimer != null) {
			clearTimeout(fadeTimer!)
			fadeTimer = null
		}
		// 每次展示都重置自动关闭计时，避免上一次的计时误杀这一次的气泡
		if (autoHideTimer != null) {
			clearTimeout(autoHideTimer!)
			autoHideTimer = null
		}

		// 序号自增：此前所有未返回的测量回调立即作废
		requestId = requestId + 1
		const reqId = requestId

		text.value = options.text
		maxWidth.value = options.maxWidth ?? DEFAULT_TOOLTIP_MAX_WIDTH
		placement.value = options.placement ?? DEFAULT_TOOLTIP_PLACEMENT

		// 自动关闭：计时由组件持有，外部无需自己 setTimeout，
		// 这样中途被手动关闭或被新气泡替换时旧计时会被正确作废
		const duration = options.duration ?? 0
		if (duration > 0) {
			autoHideTimer = setTimeout(() => {
				autoHideTimer = null
				hideTooltip()
			}, duration)
		}

		queryTarget(options.selector, options.instance ?? null, true, reqId)
	}

	// ==================== 全局事件广播监听 ====================

	/**
	 * 处理全局 show 事件
	 * 兼容两种入参场景：
	 * 1. 外部传递普通的 UTSJSONObject 字典字面量（如来自通用组件或原生 JS 桥接）
	 * 2. 外部通过 useTooltip 传递的强类型 TooltipOptions 实例对象（避免 Android 端 ClassCastException）
	 * @param raw 全局事件携带的原始载荷数据
	 */
	function handleGlobalShow(raw : any) {
		if (raw == null) return
		if (raw instanceof UTSJSONObject) {
			const obj = raw as UTSJSONObject
			const opts : TooltipOptions = {
				text: (obj['text'] ?? '') as string,
				selector: (obj['selector'] ?? '') as string,
				// 组件实例无法安全跨实例经全局事件携带，统一走全页面选择器查询
				instance: null,
				placement: (obj['placement'] ?? DEFAULT_TOOLTIP_PLACEMENT) as string,
				maxWidth: (obj['maxWidth'] ?? DEFAULT_TOOLTIP_MAX_WIDTH) as string,
				duration: (obj['duration'] ?? 0) as number,
			}
			showTooltip(opts)
		} else {
			// 直接作为 TooltipOptions 强类型实体传入
			showTooltip(raw as TooltipOptions)
		}
	}

	/**
	 * 处理全局 hide 事件
	 */
	function handleGlobalHide() {
		hideTooltip()
	}

	onMounted(() => {
		uni.$on('ste:tooltip:show', handleGlobalShow)
		uni.$on('ste:tooltip:hide', handleGlobalHide)
	})

	onUnmounted(() => {
		uni.$off('ste:tooltip:show', handleGlobalShow)
		uni.$off('ste:tooltip:hide', handleGlobalHide)
		if (hideTimer != null) {
			clearTimeout(hideTimer!)
			hideTimer = null
		}
		if (fadeTimer != null) {
			clearTimeout(fadeTimer!)
			fadeTimer = null
		}
		if (autoHideTimer != null) {
			clearTimeout(autoHideTimer!)
			autoHideTimer = null
		}
	})

	// ==================== 暴露组件实例方法 ====================
	defineExpose({
		showTooltip,
		hideTooltip,
	})
</script>

<style scoped>
	/* 根层容器：全屏固定，默认不参与命中测试，绝不遮挡页面交互 */
	.ste-tooltip-root {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 9999;
		pointer-events: none;
	}

	/* 启用「点击空白关闭」时，根层才转为可命中，作为遮罩的承载层 */
	.ste-tooltip-root--hit {
		pointer-events: auto;
	}

	/* 透明遮罩：铺满全屏接收点击，点它即关闭气泡 */
	.tooltip-mask {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		/* 完全透明在部分平台不参与命中测试，用一个几乎不可见的 alpha 兜住 */
		background-color: rgba(0, 0, 0, 0.001);
		pointer-events: auto;
		z-index: 1;
	}

	/* 悬浮气泡主外框：采用垂直方向流式排列，自然包裹内容卡片与箭头包装盒，避免超出边界被 Android 原生裁剪 */
	.tooltip-box {
		position: absolute;
		z-index: 2;
		flex-direction: column;
		transition-property: opacity;
		transition-duration: 0.2s;
		transition-timing-function: ease-out;
	}

	/* 提示气泡内容卡片 */
	.tooltip-content {
		background-color: rgba(0, 0, 0, 0.85);
		border-radius: 8rpx;
		padding: 16rpx 24rpx;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	/* 提示文字 */
	.tooltip-text {
		color: #ffffff;
		white-space: normal;
	}

	/* 箭头安全包装容器：提供真实物理高度，在正常流内占据空间，防止子节点溢出被裁剪 */
	.arrow-wrapper {
		position: relative;
		width: 100%;
		height: 10rpx;
	}

	/* 45 度旋转的实体菱形小方块（原生支持硬件加速旋转） */
	.arrow-diamond {
		position: absolute;
		width: 16rpx;
		height: 16rpx;
		background-color: rgba(0, 0, 0, 0.85);
		transform: rotate(45deg);
		border-radius: 2rpx;
	}

	/* 当方位在上方时，箭头在卡片下方：菱形上半部向上缩入卡片底边无缝融合，下半部尖角朝下在包装盒内突出 */
	.diamond-top {
		top: -8rpx;
	}

	/* 当方位在下方时，箭头在卡片上方：菱形下半部向下缩入卡片顶边无缝融合，上半部尖角朝上在包装盒内突出 */
	.diamond-bottom {
		bottom: -8rpx;
	}
</style>
